# Copy to tools/socials/.env and keep it private (chmod 600).

# Zernio: TikTok and YouTube publishing and stats
ZERNIO_API_KEY=
ZERNIO_TIKTOK_ACCOUNT_ID=
ZERNIO_YOUTUBE_ACCOUNT_ID=

# WoopSocial: Instagram and Facebook publishing
WOOPSOCIAL_API_KEY=
WOOPSOCIAL_PROJECT_ID=
WOOPSOCIAL_INSTAGRAM_ACCOUNT_ID=
WOOPSOCIAL_FACEBOOK_ACCOUNT_ID=

# Meta Graph API: Instagram and Facebook stats (bin/stats.dart). A system user token; see the README.
META_ACCESS_TOKEN=
