# Copy to tool/release/.env. Paths are relative to apps/bible.

# Google Play (deploy, listings)
ANDROID_PACKAGE_NAME=app.luxbible.app
PLAY_SERVICE_ACCOUNT_JSON=tool/release/<service-account>.json

# App Store Connect API key (deploy, listings)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_API_KEY_PATH=tool/release/AuthKey_<ASC_KEY_ID>.p8

# Store stats (store_stats). Apple needs an Admin key to request analytics reports the first time;
# leave the ASC_REPORTS_* values empty to use the key above.
ASC_REPORTS_KEY_ID=
ASC_REPORTS_API_KEY_PATH=
PLAY_REPORTS_BUCKET=pubsite_prod_<developer-id>
