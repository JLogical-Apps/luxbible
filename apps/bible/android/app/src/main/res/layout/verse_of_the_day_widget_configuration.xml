<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/configuration_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/configuration_preview"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_gravity="center"
            android:layout_margin="16dp"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/configuration_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:background="@drawable/verse_of_the_day_widget_configuration_panel">

        <TextView
            style="@style/VerseOfTheDayWidgetConfigurationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verse_of_the_day_widget_background"/>

        <RadioGroup
            android:id="@+id/configuration_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/configuration_theme_auto"
                style="@style/VerseOfTheDayWidgetConfigurationOption"
                android:text="@string/verse_of_the_day_widget_theme_auto"/>

            <RadioButton
                android:id="@+id/configuration_theme_light"
                style="@style/VerseOfTheDayWidgetConfigurationOption"
                android:text="@string/verse_of_the_day_widget_theme_light"/>

            <RadioButton
                android:id="@+id/configuration_theme_dark"
                style="@style/VerseOfTheDayWidgetConfigurationOption"
                android:text="@string/verse_of_the_day_widget_theme_dark"/>
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                style="@style/VerseOfTheDayWidgetConfigurationLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/verse_of_the_day_widget_opacity"/>

            <TextView
                android:id="@+id/configuration_opacity_value"
                style="@style/VerseOfTheDayWidgetConfigurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/configuration_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="20"/>

        <Button
            android:id="@+id/configuration_done"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/verse_of_the_day_widget_configuration_button"
            android:stateListAnimator="@null"
            android:text="@string/verse_of_the_day_widget_done"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/verse_of_the_day_widget_surface"/>
    </LinearLayout>
</LinearLayout>
