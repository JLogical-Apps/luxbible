{
  "name": "lux-scripture-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "cf-typegen": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260724.1",
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "cloudflare": {
    "bindings": {
      "API_BIBLE_KEY": {
        "description": "API.Bible key used only for server-side chapter requests."
      }
    }
  }
}
