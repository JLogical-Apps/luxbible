{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lux-scripture",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "scripture.luxbible.app",
      "custom_domain": true
    }
  ],
  "cache": {
    "enabled": true
  },
  "secrets": {
    "required": ["API_BIBLE_KEY"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
