  <para style="li1"> <verse style="v" number="12"/><char style="w" strong="H4428" x-morph="N-msc" x-position="1" x-lemma="מֶ֤לֶךְ">the king</char> <char style="w" strong="H5700" x-morph="N-proper-fs" x-position="2" x-lemma="עֶגְלוֹן֙">of Eglon,</char> <char style="w" strong="H259" x-morph="Number-ms" x-position="3" x-lemma="אֶחָ֔ד">one;</char></para>
