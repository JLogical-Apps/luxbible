  <para style="p"> <verse style="v" number="15"/><char style="w" strong="G2532" x-empty="true" x-morph="Conj" x-position="1" x-lemma="Καὶ"/><char style="w" strong="G3588" x-morph="Art-NMS" x-position="2" x-lemma="ὁ">The angel who</char> <char style="w" strong="G2980" x-morph="V-PPA-NMS" x-position="3" x-lemma="λαλῶν">spoke</char> <char style="w" strong="G3326" x-morph="Prep" x-position="4" x-lemma="μετ’">with</char> <char style="w" strong="G1473" x-morph="PPro-G1S" x-position="5" x-lemma="ἐμοῦ">me</char> <char style="w" strong="G2192" x-morph="V-IIA-3S" x-position="6" x-lemma="εἶχεν">had</char> <char style="w" strong="G5552" x-morph="Adj-ANS" x-position="9" x-lemma="χρυσοῦν">a golden</char> <char style="w" strong="G3358" x-morph="N-ANS" x-position="7" x-lemma="μέτρον">measuring</char> <char style="w" strong="G2563" x-morph="N-AMS" x-position="8" x-lemma="κάλαμον">rod</char> <char style="w" strong="G2443" x-morph="Conj" x-position="10" x-lemma="ἵνα">to</char> <char style="w" strong="G3354" x-morph="V-ASA-3S" x-position="11" x-lemma="μετρήσῃ">measure</char> <char style="w" strong="G3588" x-morph="Art-AFS" x-position="12" x-lemma="τὴν">the</char> <char style="w" strong="G4172" x-morph="N-AFS" x-position="13" x-lemma="πόλιν">city</char> <char style="w" strong="G2532" x-morph="Conj" x-position="14" x-lemma="καὶ">and</char> <char style="w" strong="G846" x-morph="PPro-GF3S" x-position="17" x-lemma="αὐτῆς">its</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AMP" x-position="15" x-lemma="τοὺς"/><char style="w" strong="G4440" x-morph="N-AMP" x-position="16" x-lemma="πυλῶνας">gates</char> <char style="w" strong="G2532" x-morph="Conj" x-position="18" x-lemma="καὶ">and</char> <char style="w" strong="G846" x-empty="true" x-morph="PPro-GF3S" x-position="21" x-lemma="αὐτῆς"/><char style="w" strong="G3588" x-empty="true" x-morph="Art-ANS" x-position="19" x-lemma="τὸ"/><char style="w" strong="G5038" x-morph="N-ANS" x-position="20" x-lemma="τεῖχος">walls.</char> <ver