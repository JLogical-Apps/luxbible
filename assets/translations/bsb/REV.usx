  <para style="s1">The Lamb Exalted</para>
  <para style="p"> <verse style="v" number="11"/><char style="w" strong="G2532" x-morph="Conj" x-position="1" x-lemma="Καὶ">Then</char> <char style="w" strong="G3708" x-morph="V-AIA-1S" x-position="2" x-lemma="εἶδον">I looked,</char> <char style="w" strong="G2532" x-morph="Conj" x-position="3" x-lemma="καὶ">and</char> <char style="w" strong="G191" x-morph="V-AIA-1S" x-position="4" x-lemma="ἤκουσα">I heard</char> <char style="w" strong="G5456" x-morph="N-AFS" x-position="5" x-lemma="φωνὴν">the voices</char> <char style="w" strong="G4183" x-morph="Adj-GMP" x-position="7" x-lemma="πολλῶν">of many</char> <char style="w" strong="G32" x-morph="N-GMP" x-position="6" x-lemma="ἀγγέλων">angels</char> <char style="w" strong="G2945" x-morph="Prep" x-position="8" x-lemma="κύκλῳ">encircling</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="9" x-lemma="τοῦ">the</char> <char style="w" strong="G2362" x-morph="N-GMS" x-position="10" x-lemma="θρόνου">throne,</char> <char style="w" strong="G2532" x-morph="Conj" x-position="11" x-lemma="καὶ">and</char> <char style="w" strong="G3588" x-morph="Art-GNP" x-position="12" x-lemma="τῶν">the</char> <char style="w" strong="G2226" x-morph="N-GNP" x-position="13" x-lemma="ζῴων">living creatures</char> <char style="w" strong="G2532" x-morph="Conj" x-position="14" x-lemma="καὶ">and</char> <char style="w" strong="G3588" x-morph="Art-GMP" x-position="15" x-lemma="τῶν">the</char> <char style="w" strong="G4245" x-morph="Adj-GMP" x-position="16" x-lemma="πρεσβυτέρων">elders.</char> <char style="w" strong="G2532" x-morph="Conj" x-position="17" x-lemma="καὶ">And</char> <char style="w" strong="G846" x-morph="PPro-GM3P" x-position="21" x-lemma="αὐτῶν">their</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NMS" x-position="19" x-lemma="ὁ"/><char style="w" strong="G706" x-morph="N-NMS" x-position="20" x-lemma="ἀριθμὸς">number</char> <char style="w" strong="G1510" x-morph="V-IIA-3S" x-position="18" x-lemma="ἦν">was</char> <cha