  <para style="b"/>
  <para style="q1"><char style="w" strong="G514" x-morph="Adj-NNS" x-position="4" x-lemma="Ἄξιόν">“Worthy</char> <char style="w" strong="G1510" x-morph="V-PIA-3S" x-position="5" x-lemma="ἐστιν">is</char> <char style="w" strong="G3588" x-morph="Art-NNS" x-position="6" x-lemma="τὸ">the</char> <char style="w" strong="G721" x-morph="N-NNS" x-position="7" x-lemma="Ἀρνίον">Lamb</char> <char style="w" strong="G3588" x-morph="Art-NNS" x-position="8" x-lemma="τὸ">who</char> <char style="w" strong="G4969" x-morph="V-RPM/P-NNS" x-position="9" x-lemma="ἐσφαγμένον">was slain,</char></para>
  <para style="q2"><char style="w" strong="G2983" x-morph="V-ANA" x-position="10" x-lemma="λαβεῖν">to receive</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AFS" x-position="11" x-lemma="τὴν"/><char style="w" strong="G1411" x-morph="N-AFS" x-position="12" x-lemma="δύναμιν">power</char> <char style="w" strong="G2532" x-morph="Conj" x-position="13" x-lemma="καὶ">and</char> <char style="w" strong="G4149" x-morph="N-AMS" x-position="14" x-lemma="πλοῦτον">riches</char></para>
