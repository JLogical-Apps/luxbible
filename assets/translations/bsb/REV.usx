  <para style="b"/>
  <para style="q1"><char style="w" strong="G3004" x-empty="true" x-morph="V-PPA-NMP" x-position="5" x-lemma="λέγοντες"/><char style="w" strong="G514" x-morph="Adj-NMS" x-position="6" x-lemma="Ἄξιος">“Worthy</char> <char style="w" strong="G1510" x-morph="V-PIA-2S" x-position="7" x-lemma="εἶ">are You</char> <char style="w" strong="G2983" x-morph="V-ANA" x-position="8" x-lemma="λαβεῖν">to take</char> <char style="w" strong="G3588" x-morph="Art-ANS" x-position="9" x-lemma="τὸ">the</char> <char style="w" strong="G975" x-morph="N-ANS" x-position="10" x-lemma="βιβλίον">scroll</char> <char style="w" strong="G2532" x-morph="Conj" x-position="11" x-lemma="καὶ">and</char> <char style="w" strong="G455" x-morph="V-ANA" x-position="12" x-lemma="ἀνοῖξαι">open</char> <char style="w" strong="G846" x-morph="PPro-GN3S" x-position="15" x-lemma="αὐτοῦ">its</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AFP" x-position="13" x-lemma="τὰς"/><char style="w" strong="G4973" x-morph="N-AFP" x-position="14" x-lemma="σφραγῖδας">seals,</char></para>
  <para style="q2"><char style="w" strong="G3754" x-morph="Conj" x-position="16" x-lemma="ὅτι">because</char> <char style="w" strong="G4969" x-morph="V-AIP-2S" x-position="17" x-lemma="ἐσφάγης">You were slain,</char></para>
  <para style="q1"><char style="w" strong="G2532" x-morph="Conj" x-position="18" x-lemma="καὶ">and</char> <char style="w" strong="G1722" x-morph="Prep" x-position="22" x-lemma="ἐν">by</char> <char style="w" strong="G4771" x-morph="PPro-G2S" x-position="25" x-lemma="σου">Your</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-DNS" x-position="23" x-lemma="τῷ"/><char style="w" strong="G129" x-morph="N-DNS" x-position="24" x-lemma="αἵματί">blood</char> <char style="w" strong="G59" x-morph="V-AIA-2S" x-position="19" x-lemma="ἠγόρασας">You purchased</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-DMS" x-position="20" x-lemma="τῷ"/><char style="w" strong="G2316" x-morph="N-DMS" x-position="21" x-lemma="Θεῷ">for God</char></para>
  <para style="q2"><char style="w" strong="G1537" x-morph="Prep" x-position="26" x-lemma="ἐκ">those from</char> <char style="w" strong="G3956" x-morph="Adj-GFS" x-position="27" x-lemma="πάσης">every</char> <char style="w" strong="G5443" x-morph="N-GFS" x-position="28" x-lemma="φυλῆς">tribe</char> <char style="w" strong="G2532" x-morph="Conj" x-position="29" x-lemma="καὶ">and</char> <char style="w" strong="G1100" x-morph="N-GFS" x-position="30" x-lemma="γλώσσης">tongue</char> <char style="w" strong="G2532" x-morph="Conj" x-position="31" x-lemma="καὶ">and</char> <char style="w" strong="G2992" x-morph="N-GMS" x-position="32" x-lemma="λαοῦ">people</char> <char style="w" strong="G2532" x-morph="Conj" x-position="33" x-lemma="καὶ">and</char> <char style="w" strong="G1484" x-morph="N-GNS" x-position="34" x-lemma="ἔθνους">nation.</char></para>
  <para style="q1"> <verse style="v" number="10"/><char style="w" strong="G2532" x-empty="true" x-morph="Conj" x-position="1" x-lemma="καὶ"/><char style="w" strong="G4160" x-morph="V-AIA-2S" x-position="2" x-lemma="ἐποίησας">You have made</char> <char style="w" strong="G846" x-morph="PPro-AM3P" x-position="3" x-lemma="αὐτοὺς">them to be</char> <char style="w" strong="G932" x-morph="N-AFS" x-position="7" x-lemma="βασιλείαν">a kingdom</char></para>
  <para style="q2"><char style="w" strong="G2532" x-morph="Conj" x-position="8" x-lemma="καὶ">and</char> <char style="w" strong="G2409" x-morph="N-AMP" x-position="9" x-lemma="ἱερεῖς">priests</char> <char style="w" strong="G3588" x-morph="Art-DMS" x-position="4" x-lemma="τῷ">to serve</char> <char style="w" strong="G1473" x-morph="PPro-G1P" x-position="6" x-lemma="ἡμῶν">our</char> <char style="w" strong="G2316" x-morph="N-DMS" x-position="5" x-lemma="Θεῷ">God,</char></para>
