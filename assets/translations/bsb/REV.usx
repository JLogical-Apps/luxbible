  <para style="p"> <verse style="v" number="3"/><char style="w" strong="G2532" x-empty="true" x-morph="Conj" x-position="1" x-lemma="Καὶ"/><char style="w" strong="G1520" x-morph="Adj-AFS" x-position="2" x-lemma="μίαν">One</char> <char style="w" strong="G1537" x-morph="Prep" x-position="3" x-lemma="ἐκ">of</char> <char style="w" strong="G3588" x-morph="Art-GFP" x-position="4" x-lemma="τῶν">the</char> <char style="w" strong="G2776" x-morph="N-GFP" x-position="5" x-lemma="κεφαλῶν">heads</char> <char style="w" strong="G846" x-morph="PPro-GN3S" x-position="6" x-lemma="αὐτοῦ">of the beast</char> <char style="w" strong="G5613" x-morph="Adv" x-position="7" x-lemma="ὡς">appeared</char> <char style="w" strong="G4969" x-morph="V-RPM/P-AFS" x-position="8" x-lemma="ἐσφαγμένην">to have been mortally wounded.</char> <char style="w" strong="G1519" x-empty="true" x-morph="Prep" x-position="9" x-lemma="εἰς"/><char style="w" strong="G2288" x-empty="true" x-morph="N-AMS" x-position="10" x-lemma="θάνατον"/><char style="w" strong="G2532" x-morph="Conj" x-position="11" x-lemma="καὶ">But</char> <char style="w" strong="G846" x-empty="true" x-morph="PPro-GN3S" x-position="16" x-lemma="αὐτοῦ"/><char style="w" strong="G3588" x-morph="Art-GMS" x-position="14" x-lemma="τοῦ">the</char> <char style="w" strong="G2288" x-morph="N-GMS" x-position="15" x-lemma="θανάτου">mortal</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NFS" x-position="12" x-lemma="ἡ"/><char style="w" strong="G4127" x-morph="N-NFS" x-position="13" x-lemma="πληγὴ">wound</char> <char style="w" strong="G2323" x-morph="V-AIP-3S" x-position="17" x-lemma="ἐθεραπεύθη">was healed,</char> <char style="w" strong="G2532" x-morph="Conj" x-position="18" x-lemma="καὶ">and</char> <char style="w" strong="G3588" x-morph="Art-NFS" x-position="21" x-lemma="ἡ">the</char> <char style="w" strong="G3650" x-morph="Adj-NFS" x-position="20" x-lemma="ὅλη">whole</char> <char style="w" strong="G1093" x-morph="N-NFS" x-position="22" x-lemma="