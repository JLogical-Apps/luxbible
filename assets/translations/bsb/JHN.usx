  <para style="s1">Prayer for All Believers</para>
  <para style="p"> <verse style="v" number="20"/><char style="wj"><char style="w" strong="G1161" x-empty="true" x-morph="Conj" x-position="4" x-lemma="δὲ"/><char style="w" strong="G3756" x-empty="true" x-morph="Adv" x-position="1" x-lemma="Οὐ"/><char style="w" strong="G2065" x-morph="V-PIA-1S" x-position="5" x-lemma="ἐρωτῶ">I am not asking</char> <char style="w" strong="G4012" x-morph="Prep" x-position="2" x-lemma="περὶ">on behalf</char> <char style="w" strong="G3778" x-morph="DPro-GMP" x-position="3" x-lemma="τούτων">of them</char> <char style="w" strong="G3440" x-morph="Adv" x-position="6" x-lemma="μόνον">alone,</char> <char style="w" strong="G235" x-morph="Conj" x-position="7" x-lemma="ἀλλὰ">but</char> <char style="w" strong="G2532" x-morph="Conj" x-position="8" x-lemma="καὶ">also</char> <char style="w" strong="G4012" x-morph="Prep" x-position="9" x-lemma="περὶ">on behalf of</char> <char style="w" strong="G3588" x-morph="Art-GMP" x-position="10" x-lemma="τῶν">those who</char> <char style="w" strong="G4100" x-morph="V-PPA-GMP" x-position="11" x-lemma="πιστευόντων">will believe</char> <char style="w" strong="G1519" x-morph="Prep" x-position="16" x-lemma="εἰς">in</char> <char style="w" strong="G1473" x-morph="PPro-A1S" x-position="17" x-lemma="ἐμέ">Me</char> <char style="w" strong="G1223" x-morph="Prep" x-position="12" x-lemma="διὰ">through</char> <char style="w" strong="G846" x-morph="PPro-GM3P" x-position="15" x-lemma="αὐτῶν">their</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-GMS" x-position="13" x-lemma="τοῦ"/><char style="w" strong="G3056" x-morph="N-GMS" x-position="14" x-lemma="λόγου">message,</char> <verse style="v" number="21"/><char style="w" strong="G2443" x-morph="Conj" x-position="1" x-lemma="ἵνα">that</char> <char style="w" strong="G3956" x-morph="Adj-NMP" x-position="2" x-lemma="πάντες">all of them</char> <char style="w" strong="G1510" x-morph="V-PSA-3P" x-position="4" x-lemma="ὦσιν">may be</char> <char style="w" strong="G1520" x-m