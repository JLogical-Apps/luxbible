  <para style="p"> <verse style="v" number="22"/><char style="wj"><char style="w" strong="G2504" x-morph="PPro-N1S" x-position="1" x-lemma="Κἀγὼ">I</char> <char style="w" strong="G1325" x-morph="V-RIA-1S" x-position="7" x-lemma="δέδωκα">have given</char> <char style="w" strong="G846" x-morph="PPro-DM3P" x-position="8" x-lemma="αὐτοῖς">them</char> <char style="w" strong="G3588" x-morph="Art-AFS" x-position="2" x-lemma="τὴν">the</char> <char style="w" strong="G1391" x-morph="N-AFS" x-position="3" x-lemma="δόξαν">glory</char> <char style="w" strong="G3739" x-empty="true" x-morph="RelPro-AFS" x-position="4" x-lemma="ἣν"/><char style="w" strong="G1325" x-morph="V-RIA-2S" x-position="5" x-lemma="δέδωκάς">You gave</char> <char style="w" strong="G1473" x-morph="PPro-D1S" x-position="6" x-lemma="μοι">Me,</char> <char style="w" strong="G2443" x-morph="Conj" x-position="9" x-lemma="ἵνα">so that</char> <char style="w" strong="G1510" x-morph="V-PSA-3P" x-position="10" x-lemma="ὦσιν">they may be</char> <char style="w" strong="G1520" x-morph="Adj-NNS" x-position="11" x-lemma="ἓν">one</char> <char style="w" strong="G2531" x-morph="Adv" x-position="12" x-lemma="καθὼς">as</char> <char style="w" strong="G1473" x-morph="PPro-N1P" x-position="13" x-lemma="ἡμεῖς">We</char> <char style="w" strong="G1520" x-morph="Adj-NNS" x-position="14" x-lemma="ἕν">are one</char> — <verse style="v" number="23"/><char style="w" strong="G1473" x-morph="PPro-N1S" x-position="1" x-lemma="ἐγὼ">I</char> <char style="w" strong="G1722" x-morph="Prep" x-position="2" x-lemma="ἐν">in</char> <char style="w" strong="G846" x-morph="PPro-DM3P" x-position="3" x-lemma="αὐτοῖς">them</char> <char style="w" strong="G2532" x-morph="Conj" x-position="4" x-lemma="καὶ">and</char> <char style="w" strong="G4771" x-morph="PPro-N2S" x-position="5" x-lemma="σὺ">You</char> <char style="w" strong="G1722" x-morph="Prep" x-position="6" x-lemma="ἐν">in</char> <char style="w" strong="G1473" x-morph="PPro-D1S" x-position="7" x-lemma="ἐμοί