  <para style="p"> <verse style="v" number="12"/><char style="wj"><char style="w" strong="G3778" x-morph="DPro-NFS" x-position="1" x-lemma="Αὕτη">This</char> <char style="w" strong="G1510" x-morph="V-PIA-3S" x-position="2" x-lemma="ἐστὶν">is</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NFS" x-position="5" x-lemma="ἡ"/><char style="w" strong="G1699" x-morph="PPro-NF1S" x-position="6" x-lemma="ἐμὴ">My</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NFS" x-position="3" x-lemma="ἡ"/><char style="w" strong="G1785" x-morph="N-NFS" x-position="4" x-lemma="ἐντολὴ">commandment,</char> <char style="w" strong="G2443" x-morph="Conj" x-position="7" x-lemma="ἵνα">that</char> <char style="w" strong="G25" x-morph="V-PSA-2P" x-position="8" x-lemma="ἀγαπᾶτε">you love</char> <char style="w" strong="G240" x-morph="RecPro-AMP" x-position="9" x-lemma="ἀλλήλους">one another</char> <char style="w" strong="G2531" x-morph="Adv" x-position="10" x-lemma="καθὼς">as</char> <char style="w" strong="G25" x-morph="V-AIA-1S" x-position="11" x-lemma="ἠγάπησα">I have loved</char> <char style="w" strong="G4771" x-morph="PPro-A2P" x-position="12" x-lemma="ὑμᾶς">you.</char> <verse style="v" number="13"/><char style="w" strong="G3173" x-morph="Adj-AFS-C" x-position="1" x-lemma="μείζονα">Greater</char> <char style="w" strong="G26" x-morph="N-AFS" x-position="3" x-lemma="ἀγάπην">love</char> <char style="w" strong="G2192" x-morph="V-PIA-3S" x-position="5" x-lemma="ἔχει">has</char> <char style="w" strong="G3762" x-morph="Adj-NMS" x-position="4" x-lemma="οὐδεὶς">no one</char> <char style="w" strong="G3778" x-morph="DPro-GFS" x-position="2" x-lemma="ταύτης">than this,</char> <char style="w" strong="G2443" x-morph="Conj" x-position="6" x-lemma="ἵνα">that</char> <char style="w" strong="G5100" x-morph="IPro-NMS" x-position="7" x-lemma="τις">he</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AFS" x-position="8" x-lemma="τὴν"/><char style="w" strong="G5087" x-m