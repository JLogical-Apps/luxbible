  <para style="p"> <verse style="v" number="15"/><char style="wj"><char style="w" strong="G3756" x-empty="true" x-morph="Adv" x-position="1" x-lemma="Οὐκ"/><char style="w" strong="G2065" x-morph="V-PIA-1S" x-position="2" x-lemma="ἐρωτῶ">I am not asking</char> <char style="w" strong="G2443" x-morph="Conj" x-position="3" x-lemma="ἵνα">that</char> <char style="w" strong="G142" x-morph="V-ASA-2S" x-position="4" x-lemma="ἄρῃς">You take</char> <char style="w" strong="G846" x-morph="PPro-AM3P" x-position="5" x-lemma="αὐτοὺς">them</char> <char style="w" strong="G1537" x-morph="Prep" x-position="6" x-lemma="ἐκ">out of</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="7" x-lemma="τοῦ">the</char> <char style="w" strong="G2889" x-morph="N-GMS" x-position="8" x-lemma="κόσμου">world,</char> <char style="w" strong="G235" x-morph="Conj" x-position="9" x-lemma="ἀλλ’">but</char> <char style="w" strong="G2443" x-morph="Conj" x-position="10" x-lemma="ἵνα">that</char> <char style="w" strong="G5083" x-morph="V-ASA-2S" x-position="11" x-lemma="τηρήσῃς">You keep</char> <char style="w" strong="G846" x-morph="PPro-AM3P" x-position="12" x-lemma="αὐτοὺς">them</char> <char style="w" strong="G1537" x-morph="Prep" x-position="13" x-lemma="ἐκ">from</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="14" x-lemma="τοῦ">the</char> <char style="w" strong="G4190" x-morph="Adj-GMS" x-position="15" x-lemma="πονηροῦ">evil one.</char><note style="f" caller="+"><char style="fr">17:15 </char><char style="ft">Or </char><char style="fqa">from evil</char></note> <verse style="v" number="16"/><char style="w" strong="G1510" x-morph="V-PIA-3P" x-position="5" x-lemma="εἰσὶν">They are</char> <char style="w" strong="G3756" x-morph="Adv" x-position="4" x-lemma="οὐκ">not</char> <char style="w" strong="G1537" x-morph="Prep" x-position="1" x-lemma="ἐκ">of</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="2" x-lemma="τοῦ">the</char> <char style="w" strong="G2889" x-morph