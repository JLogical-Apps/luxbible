  <para style="p"> <verse style="v" number="7"/><char style="w" strong="G1063" x-empty="true" x-morph="Conj" x-position="3" x-lemma="γὰρ"/><char style="w" strong="G3303" x-empty="true" x-morph="Conj" x-position="2" x-lemma="μὲν"/><char style="w" strong="G435" x-morph="N-NMS" x-position="1" x-lemma="Ἀνὴρ">A man</char> <char style="w" strong="G3784" x-morph="V-PIA-3S" x-position="5" x-lemma="ὀφείλει">ought</char> <char style="w" strong="G3756" x-morph="Adv" x-position="4" x-lemma="οὐκ">not</char> <char style="w" strong="G2619" x-morph="V-PNM/P" x-position="6" x-lemma="κατακαλύπτεσθαι">to cover</char> <char style="w" strong="G3588" x-morph="Art-AFS" x-position="7" x-lemma="τὴν">his</char> <char style="w" strong="G2776" x-morph="N-AFS" x-position="8" x-lemma="κεφαλήν">head,</char> <char style="w" strong="G5225" x-morph="V-PPA-NMS" x-position="13" x-lemma="ὑπάρχων">since he is</char> <char style="w" strong="G1504" x-morph="N-NFS" x-position="9" x-lemma="εἰκὼν">the image</char> <char style="w" strong="G2532" x-morph="Conj" x-position="10" x-lemma="καὶ">and</char> <char style="w" strong="G1391" x-morph="N-NFS" x-position="11" x-lemma="δόξα">glory</char> <char style="w" strong="G2316" x-morph="N-GMS" x-position="12" x-lemma="Θεοῦ">of God;</char> <char style="w" strong="G1161" x-morph="Conj" x-position="16" x-lemma="δὲ">but</char> <char style="w" strong="G3588" x-morph="Art-NFS" x-position="14" x-lemma="ἡ">the</char> <char style="w" strong="G1135" x-morph="N-NFS" x-position="15" x-lemma="γυνὴ">woman</char> <char style="w" strong="G1510" x-morph="V-PIA-3S" x-position="19" x-lemma="ἐστιν">is</char> <char style="w" strong="G1391" x-morph="N-NFS" x-position="17" x-lemma="δόξα">the glory</char> <char style="w" strong="G435" x-morph="N-GMS" x-position="18" x-lemma="ἀνδρός">of man.</char> <verse style="v" number="8"/><char style="w" strong="G1063" x-morph="Conj" x-position="2" x-lemma="γάρ">For</char> <char style="w" strong="G435" x-morph="N-NMS" x-position="4" x-lemma="ἀνὴρ">man</char> <char style="w" strong="G1510" x-morph="V-PIA-3S" x-position="3" x-lemma="ἐστιν">did not come</char> <char style="w" strong="G3756" x-empty="true" x-morph="Adv" x-position="1" x-lemma="οὐ"/><char style="w" strong="G1537" x-morph="Prep" x-position="5" x-lemma="ἐκ">from</char> <char style="w" strong="G1135" x-morph="N-GFS" x-position="6" x-lemma="γυναικός">woman,</char> <char style="w" strong="G235" x-morph="Conj" x-position="7" x-lemma="ἀλλὰ">but</char> <char style="w" strong="G1135" x-morph="N-NFS" x-position="8" x-lemma="γυνὴ">woman</char> <char style="w" strong="G1537" x-morph="Prep" x-position="9" x-lemma="ἐξ">from</char> <char style="w" strong="G435" x-morph="N-GMS" x-position="10" x-lemma="ἀνδρός">man.</char> <verse style="v" number="9"/><char style="w" strong="G2532" x-morph="Conj" x-position="1" x-lemma="καὶ">Neither</char> <char style="w" strong="G1063" x-empty="true" x-morph="Conj" x-position="2" x-lemma="γὰρ"/><char style="w" strong="G3756" x-empty="true" x-morph="Adv" x-position="3" x-lemma="οὐκ"/><char style="w" strong="G435" x-morph="N-NMS" x-position="5" x-lemma="ἀνὴρ">was man</char> <char style="w" strong="G2936" x-morph="V-AIP-3S" x-position="4" x-lemma="ἐκτίσθη">created</char> <char style="w" strong="G1223" x-morph="Prep" x-position="6" x-lemma="διὰ">for</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AFS" x-position="7" x-lemma="τὴν"/><char style="w" strong="G1135" x-morph="N-AFS" x-position="8" x-lemma="γυναῖκα">woman,</char> <char style="w" strong="G235" x-morph="Conj" x-position="9" x-lemma="ἀλλὰ">but</char> <char style="w" strong="G1135" x-morph="N-NFS" x-position="10" x-lemma="γυνὴ">woman</char> <char style="w" strong="G1223" x-morph="Prep" x-position="11" x-lemma="διὰ">for</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AMS" x-position="12" x-lemma="τὸν"/><char style="w" strong="G435" x-morph="N-AMS" x-position="13" x-lemma="ἄνδρα">man.</char> <verse style="v" number="10"/><char style="w" strong="G122