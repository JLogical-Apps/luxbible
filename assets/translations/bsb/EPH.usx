  <para style="p"> <verse style="v" number="22"/><char style="w" strong="G2532" x-morph="Conj" x-position="1" x-lemma="καὶ">And</char> <char style="w" strong="G5293" x-morph="V-AIA-3S" x-position="3" x-lemma="ὑπέταξεν">God put</char> <char style="w" strong="G3956" x-morph="Adj-ANP" x-position="2" x-lemma="πάντα">everything</char> <char style="w" strong="G5259" x-morph="Prep" x-position="4" x-lemma="ὑπὸ">under</char> <char style="w" strong="G846" x-morph="PPro-GM3S" x-position="7" x-lemma="αὐτοῦ">His</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AMP" x-position="5" x-lemma="τοὺς"/><char style="w" strong="G4228" x-morph="N-AMP" x-position="6" x-lemma="πόδας">feet</char> <char style="w" strong="G2532" x-morph="Conj" x-position="8" x-lemma="καὶ">and</char> <char style="w" strong="G1325" x-morph="V-AIA-3S" x-position="10" x-lemma="ἔδωκεν">made</char> <char style="w" strong="G846" x-morph="PPro-AM3S" x-position="9" x-lemma="αὐτὸν">Him</char> <char style="w" strong="G2776" x-morph="N-AFS" x-position="11" x-lemma="κεφαλὴν">head</char> <char style="w" strong="G5228" x-morph="Prep" x-position="12" x-lemma="ὑπὲρ">over</char> <char style="w" strong="G3956" x-morph="Adj-ANP" x-position="13" x-lemma="πάντα">everything</char> <char style="w" strong="G3588" x-morph="Art-DFS" x-position="14" x-lemma="τῇ">for the</char> <char style="w" strong="G1577" x-morph="N-DFS" x-position="15" x-lemma="ἐκκλησίᾳ">church,</char> <verse style="v" number="23"/><char style="w" strong="G3748" x-morph="RelPro-NFS" x-position="1" x-lemma="ἥτις">which</char> <char style="w" strong="G1510" x-morph="V-PIA-3S" x-position="2" x-lemma="ἐστὶν">is</char> <char style="w" strong="G846" x-morph="PPro-GM3S" x-position="5" x-lemma="αὐτοῦ">His</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NNS" x-position="3" x-lemma="τὸ"/><char style="w" strong="G4983" x-morph="N-NNS" x-position="4" x-lemma="σῶμα">body,</char> <char style="w" strong="G3588" x-morph="Art-NNS" x-position="6" x-le