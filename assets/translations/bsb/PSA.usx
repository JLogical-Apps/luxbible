  <para style="q1"> <verse style="v" number="129"/><char style="w" strong="H6382" x-morph="N-mp" x-position="1" x-lemma="פְּלָא֥וֹת">Wonderful are</char> <char style="w" strong="H5715" x-morph="N-fpc | 2ms" x-position="2" x-lemma="עֵדְוֺתֶ֑יךָ">Your testimonies;</char></para>
  <para style="q2"><char style="w" strong="H5921" x-morph="Prep" x-position="3" x-lemma="עַל־">therefore</char> <char style="w" strong="H3651" x-empty="true" x-morph="Adv" x-position="4" x-lemma="כֵּ֝֗ן"/><char style="w" strong="H5315" x-morph="N-fsc | 1cs" x-position="6" x-lemma="נַפְשִֽׁי׃">I</char> <char style="w" strong="H5341" x-morph="V-Qal-Perf-3fs | 3mp" x-position="5" x-lemma="נְצָרָ֥תַם">obey them.</char></para>
  <para style="q1"> <verse style="v" number="130"/><char style="w" strong="H6608" x-morph="N-msc" x-position="1" x-lemma="פֵּ֖תַח">The unfolding</char> <char style="w" strong="H1697" x-morph="N-mpc | 2ms" x-position="2" x-lemma="דְּבָרֶ֥יךָ">of Your words</char> <char style="w" strong="H215" x-morph="V-Hifil-Imperf-3ms" x-position="3" x-lemma="יָאִ֗יר">gives light;</char></para>
  <para style="q2"><char style="w" strong="H995" x-morph="V-Hifil-Prtcpl-ms" x-position="4" x-lemma="מֵבִ֥ין">it informs</char> <char style="w" strong="H6612" x-morph="N-mp" x-position="5" x-lemma="פְּתָיִֽים׃">the simple.</char></para>
  <para style="q1"> <verse style="v" number="131"/><char style="w" strong="H6473" x-morph="V-Qal-Perf-1cs" x-position="2" x-lemma="פָ֭עַרְתִּי">I open</char> <char style="w" strong="H6310" x-morph="N-msc | 1cs" x-position="1" x-lemma="פִּֽי־">my mouth</char> <char style="w" strong="H7602" x-morph="Conj-w | V-Qal-ConsecImperf-1cs | 3fs" x-position="3" x-lemma="וָאֶשְׁאָ֑פָה">and pant,</char></para>
  <para style="q2"><char style="w" strong="H3588" x-empty="true" x-morph="Conj" x-position="4" x-lemma="כִּ֖י"/><char style="w" strong="H2968" x-morph="V-Qal-Perf-1cs" x-position="6" x-lemma="יָאָֽבְתִּי׃">longing</char> <char style="w" strong="H4687" x-morph="Prep-l | N-fpc | 2ms" x-position="5" x-lemma="לְמִצְוֺתֶ֣יךָ">for Your commandments.</char></para>
  <para style="q1"> <verse style="v" number="132"/><char style="w" strong="H6437" x-morph="V-Qal-Imp-ms" x-position="1" x-lemma="פְּנֵה־">Turn</char> <char style="w" strong="H413" x-morph="Prep | 1cs" x-position="2" x-lemma="אֵלַ֥י">to me</char> <char style="w" strong="H2603" x-morph="Conj-w | V-Qal-Imp-ms | 1cs" x-position="3" x-lemma="וְחָנֵּ֑נִי">and show me mercy,</char></para>
  <para style="q2"><char style="w" strong="H4941" x-morph="Prep-k | N-ms" x-position="4" x-lemma="כְּ֝מִשְׁפָּ֗ט">as You do</char> <char style="w" strong="H157" x-morph="Prep-l | V-Qal-Prtcpl-mpc" x-position="5" x-lemma="לְאֹהֲבֵ֥י">to those who love</char> <char style="w" strong="H8034" x-morph="N-msc | 2ms" x-position="6" x-lemma="שְׁמֶֽךָ׃">Your name.</char></para>
  <para style="q1"> <verse style="v" number="133"/><char style="w" strong="H3559" x-morph="V-Hifil-Imp-ms" x-position="2" x-lemma="הָכֵ֣ן">Order</char> <char style="w" strong="H6471" x-morph="N-fpc | 1cs" x-position="1" x-lemma="פְּ֭עָמַי">my steps</char> <char style="w" strong="H565" x-morph="Prep-b | N-fsc | 2ms" x-position="3" x-lemma="בְּאִמְרָתֶ֑ךָ">in Your word;</char></para>
  <para style="q2"><char style="w" strong="H408" x-morph="Conj-w | Adv" x-position="4" x-lemma="וְֽאַל־">let no</char> <char style="w" strong="H3605" x-empty="true" x-morph="N-msc" x-position="7" x-lemma="כָל־"/><char style="w" strong="H205" x-morph="N-ms" x-position="8" x-lemma="אָֽוֶן׃">sin</char> <char style="w" strong="H7980" x-morph="V-Hifil-Imperf-3fs" x-position="5" x-lemma="תַּשְׁלֶט־">rule</char> <char style="w" strong="" x-morph="Prep | 1cs" x-position="6" x-lemma="בִּ֥י">over me.</char></para>
  <para style="q1"> <verse style="v" number="134"/><char style="w" strong="H6299" x-morph="V-Qal-Imp-ms | 1cs" x-position="1" x-lemma="פְּ֭דֵנִי">Redeem me</char> <char style="w" strong="H6233" x-morph="Prep-m | N-msc" x-position="2" x-lemma="מֵעֹ֣שֶׁק">from the oppression</char> <char style="w" strong="H120" x-morph="N-ms" x-position="3" x-lemma="אָדָ֑ם">of man,</char></para>
  <para style="q2"><char style="w" strong="H8104" x-morph="Conj-w | V-Qal-ConjImperf.Cohort-1cs" x-position="4" x-lemma="וְ֝אֶשְׁמְרָ֗ה">that I may keep</char> <char style="w" strong="H6490" x-morph="N-mpc | 2ms" x-position="5" x-lemma="פִּקּוּדֶֽיךָ׃">Your precepts.</char></para>
  <para style="q1"> <verse style="v" number="135"/><char style="w" strong="H6440" x-morph="N-cpc | 2ms" x-position="1" x-lemma="פָּ֭נֶיךָ">Make Your face</char> <char style="w" strong="H215" x-morph="V-Hifil-Imp-ms" x-position="2" x-lemma="הָאֵ֣ר">shine</char> <char style="w" strong="H5650" x-morph="Prep-b | N-msc | 2ms" x-position="3" x-lemma="בְּעַבְדֶּ֑ךָ">upon Your servant,</char></para>
  <para style="q2"><char style="w" strong="H3925" x-morph="Conj-w | V-Piel-Imp-ms | 1cs" x-position="4" x-lemma="וְ֝לַמְּדֵ֗נִי">and teach</char> <char style="w" strong="H853" x-morph="DirObjM" x-position="5" x-lemma="אֶת־">me</char> <char style="w" strong="H2706" x-morph="N-mpc | 2ms" x-position="6" x-lemma="חֻקֶּֽיךָ׃">Your statutes.</char></para>
  <para style="q1"> <verse style="v" number="136"/><char style="w" strong="H5869" x-morph="N-cdc | 1cs" x-position="4" x-lemma="עֵינָ֑י">My eyes</char> <char style="w" strong="H3381" x-morph="V-Qal-Perf-3cp" x-position="3" x-lemma="יָרְד֣וּ">shed</char> <char style="w" strong="H6388" x-morph="N-mpc" x-position="1" x-lemma="פַּלְגֵי־">streams</char> <char style="w" strong="H4325" x-morph="N-mp" x-position="2" x-lemma="מַ֭יִם">of tears</char></para>
