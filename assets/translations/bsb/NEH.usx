  <para style="li1"><char style="w" strong="H1121" x-morph="N-mpc" x-position="5" x-lemma="בְּנֵ֥י">the descendants</char> <char style="w" strong="H6454" x-morph="N-proper-ms" x-position="6" x-lemma="פָסֵֽחַ׃">of Paseah,</char></para>
  <para style="li1"> <verse style="v" number="52"/><char style="w" strong="H1121" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵי־">the descendants</char> <char style="w" strong="H1153" x-morph="N-proper-ms" x-position="2" x-lemma="בֵסַ֥י">of Besai,</char></para>
