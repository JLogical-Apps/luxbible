  <para style="li1"> <verse style="v" number="51"/><char style="w" strong="H1121" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵי־">the descendants</char> <char style="w" strong="H1502" x-morph="N-proper-ms" x-position="2" x-lemma="גַזָּ֥ם">of Gazzam,</char></para>
