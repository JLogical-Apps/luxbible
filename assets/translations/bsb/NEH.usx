  <para style="li2">138 <char style="w" strong="H3967" x-morph="Number-fs" x-position="14" x-lemma="מֵאָ֖ה">in all.</char></para>
  <para style="p"> <verse style="v" number="46"/><char style="w" strong="H5411" x-morph="Art | N-mp" x-position="1" x-lemma="הַנְּתִינִ֑ים">The temple servants:</char><note style="f" caller="+"><char style="fr">7:46 </char><char style="ft">Hebrew </char><char style="fqa">The Nethinim</char><char style="ft">; also in verses 60 and 73</char></note></para>
  <para style="b"/>
  <para style="li1"><char style="w" strong="H1121" x-morph="N-mpc" x-position="2" x-lemma="בְּנֵי־">the descendants</char> <char style="w" strong="H6727" x-morph="N-proper-ms" x-position="3" x-lemma="צִחָ֥א">of Ziha,</char></para>
