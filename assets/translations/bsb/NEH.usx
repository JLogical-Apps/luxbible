  <para style="li1"><char style="w" strong="H1121" x-morph="N-mpc" x-position="5" x-lemma="בְּנֵ֥י">the descendants</char> <char style="w" strong="H2797" x-morph="N-proper-ms" x-position="6" x-lemma="חַרְשָֽׁא׃">of Harsha,</char></para>
  <para style="li1"> <verse style="v" number="55"/><char style="w" strong="H1121" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵי־">the descendants</char> <char style="w" strong="H1302" x-morph="N-proper-ms" x-position="2" x-lemma="בַרְק֥וֹס">of Barkos,</char></para>
