  <para style="li1"><char style="w" strong="H1121" x-morph="N-mpc" x-position="5" x-lemma="בְּנֵ֥י">the descendants</char> <char style="w" strong="H5300" x-morph="N-proper-mp" x-position="6" x-lemma="נְפוּשְׁסִים׃">of Nephushesim,</char><note style="f" caller="+"><char style="fr">7:52 </char><char style="fqa">Nephushesim </char><char style="ft">is a variant of </char><char style="fqa">Nephusim</char><char style="ft">; see <ref loc="EZR 2:50">Ezra 2:50</ref>.</char></note></para>
  <para style="li1"> <verse style="v" number="53"/><char style="w" strong="H1121" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵי־">the descendants</char> <char style="w" strong="H1227" x-morph="N-proper-ms" x-position="2" x-lemma="בַקְבּ֥וּק">of Bakbuk,</char></para>
