  <para style="li1"><char style="w" strong="H1121" x-morph="N-mpc" x-position="5" x-lemma="בְּנֵ֥י">the descendants</char> <char style="w" strong="H2744" x-morph="N-proper-ms" x-position="6" x-lemma="חַרְחֽוּר׃">of Harhur,</char></para>
  <para style="li1"> <verse style="v" number="54"/><char style="w" strong="H1121" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵי־">the descendants</char> <char style="w" strong="H1213" x-morph="N-proper-ms" x-position="2" x-lemma="בַצְלִ֥ית">of Bazlith,</char><note style="f" caller="+"><char style="fr">7:54 </char><char style="fqa">Bazlith </char><char style="ft">is a variant of </char><char style="fqa">Bazluth</char><char style="ft">; see <ref loc="EZR 2:52">Ezra 2:52</ref>.</char></note></para>
