  <para style="p"> <verse style="v" number="42"/><char style="wj"><char style="w" strong="G3767" x-morph="Conj" x-position="2" x-lemma="οὖν">Therefore</char> <char style="w" strong="G1127" x-morph="V-PMA-2P" x-position="1" x-lemma="Γρηγορεῖτε">keep watch,</char> <char style="w" strong="G3754" x-morph="Conj" x-position="3" x-lemma="ὅτι">because</char> <char style="w" strong="G3756" x-empty="true" x-morph="Adv" x-position="4" x-lemma="οὐκ"/><char style="w" strong="G1492" x-morph="V-RIA-2P" x-position="5" x-lemma="οἴδατε">you do not know</char> <char style="w" strong="G2250" x-morph="N-DFS" x-position="7" x-lemma="ἡμέρᾳ">the day</char> <char style="w" strong="G4169" x-morph="IPro-DFS" x-position="6" x-lemma="ποίᾳ">on which</char> <char style="w" strong="G4771" x-morph="PPro-G2P" x-position="10" x-lemma="ὑμῶν">your</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NMS" x-position="8" x-lemma="ὁ"/><char style="w" strong="G2962" x-morph="N-NMS" x-position="9" x-lemma="κύριος">Lord</char> <char style="w" strong="G2064" x-morph="V-PIM/P-3S" x-position="11" x-lemma="ἔρχεται">will come.</char> <verse style="v" number="43"/><char style="w" strong="G1161" x-morph="Conj" x-position="2" x-lemma="δὲ">But</char> <char style="w" strong="G1097" x-morph="V-PMA-2P" x-position="3" x-lemma="γινώσκετε">understand</char> <char style="w" strong="G1565" x-morph="DPro-ANS" x-position="1" x-lemma="ἐκεῖνο">this:</char> <char style="w" strong="G3754" x-empty="true" x-morph="Conj" x-position="4" x-lemma="ὅτι"/><char style="w" strong="G1487" x-morph="Conj" x-position="5" x-lemma="εἰ">If</char> <char style="w" strong="G3588" x-morph="Art-NMS" x-position="7" x-lemma="ὁ">the</char> <char style="w" strong="G3617" x-morph="N-NMS" x-position="8" x-lemma="οἰκοδεσπότης">homeowner</char> <char style="w" strong="G1492" x-morph="V-LIA-3S" x-position="6" x-lemma="ᾔδει">had known</char> <char style="w" strong="G4169" x-morph="IPro-DFS" x-position="9" x-lemma="ποίᾳ">in which</char> <char style="