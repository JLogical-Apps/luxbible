  <para style="s1">Sheep among Wolves</para>
  <para style="r">(<ref loc="2TI 1:3-12">2 Timothy 1:3–12</ref>)</para>
  <para style="p"> <verse style="v" number="16"/><char style="wj"><char style="w" strong="G2400" x-morph="V-AMA-2S" x-position="1" x-lemma="Ἰδοὺ">Behold,</char> <char style="w" strong="G1473" x-morph="PPro-N1S" x-position="2" x-lemma="ἐγὼ">I</char> <char style="w" strong="G649" x-morph="V-PIA-1S" x-position="3" x-lemma="ἀποστέλλω">am sending you out</char> <char style="w" strong="G4771" x-empty="true" x-morph="PPro-A2P" x-position="4" x-lemma="ὑμᾶς"/><char style="w" strong="G5613" x-morph="Adv" x-position="5" x-lemma="ὡς">like</char> <char style="w" strong="G4263" x-morph="N-ANP" x-position="6" x-lemma="πρόβατα">sheep</char> <char style="w" strong="G1722" x-morph="Prep" x-position="7" x-lemma="ἐν">among</char> <char style="w" strong="G3319" x-empty="true" x-morph="Adj-DNS" x-position="8" x-lemma="μέσῳ"/><char style="w" strong="G3074" x-morph="N-GMP" x-position="9" x-lemma="λύκων">wolves;</char> <char style="w" strong="G3767" x-morph="Conj" x-position="11" x-lemma="οὖν">therefore</char> <char style="w" strong="G1096" x-morph="V-PMM/P-2P" x-position="10" x-lemma="γίνεσθε">be</char> <char style="w" strong="G5429" x-morph="Adj-NMP" x-position="12" x-lemma="φρόνιμοι">as shrewd</char> <char style="w" strong="G5613" x-morph="Adv" x-position="13" x-lemma="ὡς">as</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NMP" x-position="14" x-lemma="οἱ"/><char style="w" strong="G3789" x-morph="N-NMP" x-position="15" x-lemma="ὄφεις">snakes</char> <char style="w" strong="G2532" x-morph="Conj" x-position="16" x-lemma="καὶ">and</char> <char style="w" strong="G185" x-morph="Adj-NMP" x-position="17" x-lemma="ἀκέραιοι">as innocent</char> <char style="w" strong="G5613" x-morph="Adv" x-position="18" x-lemma="ὡς">as</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NFP" x-position="19" x-lemma="αἱ"/><char style="w" strong="G4058" x-morph="N-NFP" x-position="20" x-lemma="περιστεραί">doves.</char> <verse style="v" number="17"/><char style="w" strong="G1161" x-mor