  <para style="p"> <verse style="v" number="36"/><char style="wj"><char style="w" strong="G1161" x-empty="true" x-morph="Conj" x-position="2" x-lemma="δὲ"/><char style="w" strong="G3762" x-morph="Adj-NMS" x-position="8" x-lemma="οὐδεὶς">No one</char> <char style="w" strong="G1492" x-morph="V-RIA-3S" x-position="9" x-lemma="οἶδεν">knows</char> <char style="w" strong="G4012" x-morph="Prep" x-position="1" x-lemma="Περὶ">about</char> <char style="w" strong="G1565" x-morph="DPro-GFS" x-position="5" x-lemma="ἐκείνης">that</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-GFS" x-position="3" x-lemma="τῆς"/><char style="w" strong="G2250" x-morph="N-GFS" x-position="4" x-lemma="ἡμέρας">day</char> <char style="w" strong="G2532" x-morph="Conj" x-position="6" x-lemma="καὶ">or</char> <char style="w" strong="G5610" x-morph="N-GFS" x-position="7" x-lemma="ὥρας">hour,</char> <char style="w" strong="G3761" x-morph="Adv" x-position="10" x-lemma="οὐδὲ">not even</char> <char style="w" strong="G3588" x-morph="Art-NMP" x-position="11" x-lemma="οἱ">the</char> <char style="w" strong="G32" x-morph="N-NMP" x-position="12" x-lemma="ἄγγελοι">angels</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-GMP" x-position="13" x-lemma="τῶν"/><char style="w" strong="G3772" x-morph="N-GMP" x-position="14" x-lemma="οὐρανῶν">in heaven,</char> <char style="w" strong="G3761" x-morph="Conj" x-position="15" x-lemma="οὐδὲ">nor</char> <char style="w" strong="G3588" x-morph="Art-NMS" x-position="16" x-lemma="ὁ">the</char> <char style="w" strong="G5207" x-morph="N-NMS" x-position="17" x-lemma="Υἱός">Son,</char><note style="f" caller="+"><char style="fr">24:36 </char><char style="ft">BYZ and TR do not include </char><char style="fqa">nor the Son</char><char style="ft">.</char></note> <char style="w" strong="G1487" x-morph="Conj" x-position="18" x-lemma="εἰ">but</char> <char style="w" strong="G3361" x-empty="true" x-morph="Adv" x-position="19" x-lemma="μὴ"/><char style="w" strong="G34