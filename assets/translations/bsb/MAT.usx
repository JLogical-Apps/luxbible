ong="G3056" x-morph="N-AMP" x-position="10" x-lemma="λόγους">words,</char> <char style="w" strong="G1621" x-morph="V-AMA-2P" x-position="20" x-lemma="ἐκτινάξατε">shake</char> <char style="w" strong="G3588" x-morph="Art-AMS" x-position="21" x-lemma="τὸν">the</char> <char style="w" strong="G2868" x-morph="N-AMS" x-position="22" x-lemma="κονιορτὸν">dust</char> <char style="w" strong="G3588" x-morph="Art-GMP" x-position="23" x-lemma="τῶν">off</char> <char style="w" strong="G4771" x-morph="PPro-G2P" x-position="25" x-lemma="ὑμῶν">your</char> <char style="w" strong="G4228" x-morph="N-GMP" x-position="24" x-lemma="ποδῶν">feet</char> <char style="w" strong="G1831" x-morph="V-PPM/P-NMP" x-position="12" x-lemma="ἐξερχόμενοι">when you leave</char> <char style="w" strong="G1854" x-empty="true" x-morph="Prep" x-position="13" x-lemma="ἔξω"/><char style="w" strong="G1565" x-morph="DPro-GFS" x-position="19" x-lemma="ἐκείνης">that</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-GFS" x-position="14" x-lemma="τῆς"/><char style="w" strong="G3614" x-morph="N-GFS" x-position="15" x-lemma="οἰκίας">home</char> <char style="w" strong="G2228" x-morph="Conj" x-position="16" x-lemma="ἢ">or</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-GFS" x-position="17" x-lemma="τῆς"/><char style="w" strong="G4172" x-morph="N-GFS" x-position="18" x-lemma="πόλεως">town.</char> <verse style="v" number="15"/><char style="w" strong="G281" x-morph="Heb" x-position="1" x-lemma="ἀμὴν">Truly</char> <char style="w" strong="G3004" x-morph="V-PIA-1S" x-position="2" x-lemma="λέγω">I tell</char> <char style="w" strong="G4771" x-morph="PPro-D2P" x-position="3" x-lemma="ὑμῖν">you,</char> <char style="w" strong="G1510" x-morph="V-FIM-3S" x-position="5" x-lemma="ἔσται">it will be</char> <char style="w" strong="G414" x-morph="Adj-NNS-C" x-position="4" x-lemma="ἀνεκτότερον">more bearable</char> <char style="w" strong="G1093" x-empty="true" x-morph="N-DFS" x-position="6" x-lemma="γῇ"/><char