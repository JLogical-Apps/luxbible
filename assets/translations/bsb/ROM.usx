  <para style="p"> <verse style="v" number="18"/><char style="w" strong="G686" x-morph="Conj" x-position="1" x-lemma="Ἄρα">So</char> <char style="w" strong="G3767" x-morph="Conj" x-position="2" x-lemma="οὖν">then,</char> <char style="w" strong="G5613" x-morph="Adv" x-position="3" x-lemma="ὡς">just as</char> <char style="w" strong="G1223" x-empty="true" x-morph="Prep" x-position="4" x-lemma="δι’"/><char style="w" strong="G1520" x-morph="Adj-GNS" x-position="5" x-lemma="ἑνὸς">one</char> <char style="w" strong="G3900" x-morph="N-GNS" x-position="6" x-lemma="παραπτώματος">trespass</char> <char style="w" strong="G1519" x-morph="Prep" x-position="10" x-lemma="εἰς">brought</char> <char style="w" strong="G2631" x-morph="N-ANS" x-position="11" x-lemma="κατάκριμα">condemnation</char> <char style="w" strong="G1519" x-morph="Prep" x-position="7" x-lemma="εἰς">for</char> <char style="w" strong="G3956" x-morph="Adj-AMP" x-position="8" x-lemma="πάντας">all</char> <char style="w" strong="G444" x-morph="N-AMP" x-position="9" x-lemma="ἀνθρώπους">men,</char> <char style="w" strong="G3779" x-morph="Adv" x-position="12" x-lemma="οὕτως">so</char> <char style="w" strong="G2532" x-morph="Conj" x-position="13" x-lemma="καὶ">also</char> <char style="w" strong="G1223" x-empty="true" x-morph="Prep" x-position="14" x-lemma="δι’"/><char style="w" strong="G1520" x-morph="Adj-GNS" x-position="15" x-lemma="ἑνὸς">one</char> <char style="w" strong="G1345" x-morph="N-GNS" x-position="16" x-lemma="δικαιώματος">act of righteousness</char> <char style="w" strong="G1519" x-morph="Prep" x-position="20" x-lemma="εἰς">brought</char> <char style="w" strong="G1347" x-morph="N-AFS" x-position="21" x-lemma="δικαίωσιν">justification</char> <char style="w" strong="G2222" x-morph="N-GFS" x-position="22" x-lemma="ζωῆς">and life</char> <char style="w" strong="G1519" x-morph="Prep" x-position="17" x-lemma="εἰς">for</char> <char style="w" strong="G3956" x-morph="Adj-AMP" x-position="18" x-lemma="πάντας">all</char> <cha