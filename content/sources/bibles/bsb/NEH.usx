  <para style="p"> <verse style="v" number="23"/><char style="w" strong="H310" x-morph="Prep | 3ms" x-position="1" x-lemma="אַחֲרָ֨יו" x-translit="’a·ḥă·rāw">Beyond them,</char> <char style="w" strong="H1144" x-morph="N-proper-ms" x-position="3" x-lemma="בִּנְיָמִ֛ן" x-translit="bin·yā·min">Benjamin</char> <char style="w" strong="H2815" x-morph="Conj-w | N-proper-ms" x-position="4" x-lemma="וְחַשּׁ֖וּב" x-translit="wə·ḥaš·šūḇ">and Hasshub</char> <char style="w" strong="H2388" x-morph="V-Hifil-Perf-3ms" x-position="2" x-lemma="הֶחֱזִ֧יק" x-translit="he·ḥĕ·zîq">made repairs</char> <char style="w" strong="H5048" x-morph="Prep" x-position="5" x-lemma="נֶ֣גֶד" x-translit="ne·ḡeḏ">in front</char> <char style="w" strong="H1004" x-morph="N-msc | 3mp" x-position="6" x-lemma="בֵּיתָ֑םס" x-translit="bē·ṯå̄·ms">of their house,</char> <char style="w" strong="H310" x-morph="Prep | 3ms" x-position="7" x-lemma="אַחֲרָ֣יו" x-translit="’a·ḥă·rāw">and next to them,</char> <char style="w" strong="H5838" x-morph="N-proper-ms" x-position="9" x-lemma="עֲזַרְיָ֧ה" x-translit="‘ă·zar·yāh">Azariah</char> <char style="w" strong="H1121" x-morph="N-msc" x-position="10" x-lemma="בֶן־" x-translit="ḇen-">son</char> <char style="w" strong="H4641" x-morph="N-proper-ms" x-position="11" x-lemma="מַעֲשֵׂיָ֛ה" x-translit="ma·‘ă·śê·yāh">of Maaseiah,</char> <char style="w" strong="H1121" x-morph="N-msc" x-position="12" x-lemma="בֶּן־" x-translit="ben-">the son</char> <char style="w" strong="H6055" x-morph="N-proper-ms" x-position="13" x-lemma="עֲנָֽנְיָ֖ה" x-translit="‘ă·nā·nə·yāh">of Ananiah,</char> <char style="w" strong="H2388" x-morph="V-Hifil-Perf-3ms" x-position="8" x-lemma="הֶחֱזִ֗יק" x-translit="he·ḥĕ·zîq">made repairs</char> <char style="w" strong="H681" x-morph="Prep" x-position="14" x-lemma="אֵ֥צֶל" x-translit="’ê·ṣel">beside</char> <char style="w" strong="H1004" x-morph="N-msc | 3ms" x-position="15" x-lemma="בֵּיתֽוֹ׃ס" x-translit="bê·ṯōw">his house.</char> <verse style="v" number="24"/><