  <para style="q1"> <verse style="v" number="25"/><char style="w" strong="H8432" x-morph="Prep-b | N-msc" x-position="1" x-lemma="בְּת֣וֹךְ" x-translit="bə·ṯō·wḵ">Among</char> <char style="w" strong="H2491" x-morph="N-mp" x-position="2" x-lemma="חֲ֠לָלִים" x-translit="ḥă·lā·lîm">the slain</char> <char style="w" strong="H5414" x-morph="V-Qal-Perf-3cp" x-position="3" x-lemma="נָתְנ֨וּ" x-translit="nā·ṯə·nū">they prepare</char></para>
  <para style="q2"><char style="w" strong="H4904" x-morph="N-ms" x-position="4" x-lemma="מִשְׁכָּ֥ב" x-translit="miš·kāḇ">a resting place</char> <char style="w" strong="" x-morph="Prep | 3fs" x-position="5" x-lemma="לָהּ֙" x-translit="lāh">for Elam</char></para>
  <para style="q1"><char style="w" strong="H3605" x-morph="Prep-b | N-msc" x-position="6" x-lemma="בְּכָל־" x-translit="bə·ḵāl">with all</char> <char style="w" strong="H1995" x-morph="N-msc | 3fs" x-position="7" x-lemma="הֲמוֹנָ֔הּ" x-translit="hă·mō·w·nāh">her hordes,</char></para>
  <para style="q2"><char style="w" strong="H6913" x-morph="N-mpc | 3fs" x-position="9" x-lemma="קִבְרֹתֶ֑הָ" x-translit="qiḇ·rō·ṯe·hā">with her graves</char> <char style="w" strong="H5439" x-morph="Adv | 3ms" x-position="8" x-lemma="סְבִֽיבוֹתָ֖יו" x-translit="sə·ḇî·ḇō·w·ṯāw">all around her.</char></para>
  <para style="q1"><char style="w" strong="H3605" x-morph="N-msc | 3mp" x-position="10" x-lemma="כֻּלָּ֣ם" x-translit="kul·lām">All</char> <char style="w" strong="H6189" x-morph="Adj-mp" x-position="11" x-lemma="עֲרֵלִ֣ים" x-translit="‘ă·rê·lîm">of them are uncircumcised,</char></para>
