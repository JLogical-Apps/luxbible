  <para style="q1"> <verse style="v" number="27"/><char style="w" strong="H3808" x-morph="Conj-w | Adv-NegPrt" x-position="1" x-lemma="וְלֹ֤א" x-translit="wə·lō">They do not</char> <char style="w" strong="H7901" x-morph="V-Qal-Imperf-3mp" x-position="2" x-lemma="יִשְׁכְּבוּ֙" x-translit="yiš·kə·ḇū">lie down</char></para>
