  <para style="b"/>
  <para style="q1"> <verse style="v" number="26"/><char style="w" strong="H4902" x-morph="N-proper-fs" x-position="2" x-lemma="מֶ֤שֶׁךְ" x-translit="me·šeḵ">Meshech</char> <char style="w" strong="H8422" x-morph="N-proper-fs" x-position="3" x-lemma="תֻּבַל֙" x-translit="tu·ḇal">and Tubal</char> <char style="w" strong="H8033" x-morph="Adv" x-position="1" x-lemma="שָׁ֣ם" x-translit="šām">are there</char></para>
  <para style="q2"><char style="w" strong="H3605" x-morph="Conj-w | N-msc" x-position="4" x-lemma="וְכָל־" x-translit="wə·ḵāl">with all</char> <char style="w" strong="H1995" x-morph="N-msc | 3fs" x-position="5" x-lemma="הֲמוֹנָ֔הּ" x-translit="hă·mō·w·nāh">their multitudes,</char></para>
  <para style="q2"><char style="w" strong="H6913" x-morph="N-mpc | 3fs" x-position="7" x-lemma="קִבְרוֹתֶ֑יהָ" x-translit="qiḇ·rō·w·ṯe·hā">with their graves</char> <char style="w" strong="H5439" x-morph="Adv | 3ms" x-position="6" x-lemma="סְבִֽיבוֹתָ֖יו" x-translit="sə·ḇî·ḇō·w·ṯāw">all around them.</char></para>
