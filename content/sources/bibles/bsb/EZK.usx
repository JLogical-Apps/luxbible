  <para style="q1"><char style="w" strong="H5375" x-morph="Conj-w | V-Qal-ConsecImperf-3mp" x-position="19" x-lemma="וַיִּשְׂא֤וּ" x-translit="way·yiś·’ū">They bear</char> <char style="w" strong="H3639" x-morph="N-fsc | 3mp" x-position="20" x-lemma="כְלִמָּתָם֙" x-translit="ḵə·lim·mā·ṯām">their disgrace</char></para>
