  <para style="qr"><char style="w" strong="H3588" x-empty="true" x-morph="Conj" x-position="4" x-lemma="כִּ֖י"/><char style="w" strong="H2617" x-morph="N-msc | 3ms" x-position="6" x-lemma="חַסְדּֽוֹ׃" x-translit="ḥas·dōw">His loving devotion</char> <char style="w" strong="H5769" x-morph="Prep-l | N-ms" x-position="5" x-lemma="לְעוֹלָ֣ם" x-translit="lə·‘ō·w·lām">endures forever.</char></para>
  <para style="q1"> <verse style="v" number="23"/><char style="w" strong="H2142" x-morph="V-Qal-Perf-3ms" x-position="2" x-lemma="זָ֣כַר" x-translit="zā·ḵar">He remembered</char> <char style="w" strong="" x-morph="Prep | 1cp" x-position="3" x-lemma="לָ֑נוּ" x-translit="lā·nū">us</char> <char style="w" strong="H8216" x-morph="Pr, Prep-b | N-msc | 1cp" x-position="1" x-lemma="שֶׁ֭בְּשִׁפְלֵנוּ" x-translit="bə·šip̄·lê·nū">in our low estate</char></para>
  <para style="qr"><char style="w" strong="H3588" x-empty="true" x-morph="Conj" x-position="4" x-lemma="כִּ֖י"/><char style="w" strong="H2617" x-morph="N-msc | 3ms" x-position="6" x-lemma="חַסְדּֽוֹ׃" x-translit="ḥas·dōw">His loving devotion</char> <char style="w" strong="H5769" x-morph="Prep-l | N-ms" x-position="5" x-lemma="לְעוֹלָ֣ם" x-translit="lə·‘ō·w·lām">endures forever.</char></para>
  <para style="q1"> <verse style="v" number="24"/><char style="w" strong="H6561" x-morph="Conj-w | V-Qal-ConsecImperf-3ms | 1cp" x-position="1" x-lemma="וַיִּפְרְקֵ֥נוּ" x-translit="way·yip̄·rə·qê·nū">and freed us</char> <char style="w" strong="H6862" x-morph="Prep-m | N-mpc | 1cp" x-position="2" x-lemma="מִצָּרֵ֑ינוּ" x-translit="miṣ·ṣā·rê·nū">from our enemies.</char></para>
