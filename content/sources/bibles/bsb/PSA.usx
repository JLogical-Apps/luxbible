  <para style="q1"> <verse style="v" number="20"/><char style="w" strong="H5747" x-morph="Conj-w, Prep-l | N-proper-ms" x-position="1" x-lemma="וּ֭לְעוֹג" x-translit="ū·lə·‘ō·wḡ">and Og</char> <char style="w" strong="H4428" x-morph="N-msc" x-position="2" x-lemma="מֶ֣לֶךְ" x-translit="me·leḵ">king</char> <char style="w" strong="H1316" x-morph="Art | N-proper-fs" x-position="3" x-lemma="הַבָּשָׁ֑ן" x-translit="hab·bā·šān">of Bashan—</char></para>
