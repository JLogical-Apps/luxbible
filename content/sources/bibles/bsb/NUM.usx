  <para style="p"> <verse style="v" number="36"/><char style="w" strong="H2549" x-morph="Art | Number-oms" x-position="2" x-lemma="הַחֲמִישִׁ֔י" x-translit="ha·ḥă·mî·šî">On the fifth</char> <char style="w" strong="H3117" x-morph="Prep-b, Art | N-ms" x-position="1" x-lemma="בַּיּוֹם֙" x-translit="bay·yō·wm">day</char> <char style="w" strong="H8017" x-morph="N-proper-ms" x-position="6" x-lemma="שְׁלֻֽמִיאֵ֖ל" x-translit="šə·lu·mî·’êl">Shelumiel</char> <char style="w" strong="H1121" x-morph="Prep-l | N-mpc" x-position="4" x-lemma="לִבְנֵ֣י" x-translit="liḇ·nê">son</char> <char style="w" strong="H6701" x-morph="N-proper-ms" x-position="8" x-lemma="צוּרִֽישַׁדָּֽי׃" x-translit="ṣū·rî·šad·dāy">of Zurishaddai,</char> <char style="w" strong="H5387" x-morph="N-ms" x-position="3" x-lemma="נָשִׂ֖יא" x-translit="nā·śî">the leader</char> <char style="w" strong="H1121" x-morph="N-msc" x-position="7" x-lemma="בֶּן־" x-translit="ben-">of the Simeonites,</char> <char style="w" strong="H8095" x-morph="N-proper-ms" x-position="5" x-lemma="שִׁמְע֑וֹן" x-translit="šim·‘ō·wn">drew near.</char> <verse style="v" number="37"/><char style="w" strong="H7133" x-morph="N-msc | 3ms" x-position="1" x-lemma="קָרְבָּנ֞וֹ" x-translit="qā·rə·bā·nōw">His offering</char> <char style="w" strong="H259" x-morph="Number-fs" x-position="4" x-lemma="אַחַ֗ת" x-translit="’a·ḥaṯ">was one</char> <char style="w" strong="H3701" x-morph="N-ms" x-position="3" x-lemma="כֶּ֣סֶף" x-translit="ke·sep̄">silver</char> <char style="w" strong="H7086" x-morph="N-fsc" x-position="2" x-lemma="קַֽעֲרַת־" x-translit="qa·‘ă·raṯ-">platter</char> <char style="w" strong="H4948" x-morph="N-msc | 3fs" x-position="7" x-lemma="מִשְׁקָלָהּ֒" x-translit="miš·qā·lāh">weighing</char> <char style="w" strong="H7970" x-morph="Number-cp" x-position="5" x-lemma="שְׁלֹשִׁ֣ים" x-translit="šə·lō·šîm">a hundred and thirty shekels,</char> <char style="w" strong="H3967" x-empty="true" x-morph="Conj-w | Number-fs" x-position="6" x-lemma="וּמֵאָה֮"/><c