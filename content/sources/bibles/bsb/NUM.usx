  <para style="p"> <verse style="v" number="18"/><char style="w" strong="H8145" x-morph="Art | Number-oms" x-position="2" x-lemma="הַשֵּׁנִ֔י" x-translit="haš·šê·nî">On the second</char> <char style="w" strong="H3117" x-morph="Prep-b, Art | N-ms" x-position="1" x-lemma="בַּיּוֹם֙" x-translit="bay·yō·wm">day</char> <char style="w" strong="H5417" x-morph="N-proper-ms" x-position="4" x-lemma="נְתַנְאֵ֣ל" x-translit="nə·ṯan·’êl">Nethanel</char> <char style="w" strong="H1121" x-morph="N-msc" x-position="5" x-lemma="בֶּן־" x-translit="ben-">son</char> <char style="w" strong="H6686" x-morph="N-proper-ms" x-position="6" x-lemma="צוּעָ֑ר" x-translit="ṣū·‘ār">of Zuar,</char> <char style="w" strong="H5387" x-morph="N-msc" x-position="7" x-lemma="נְשִׂ֖יא" x-translit="nə·śî">the leader</char> <char style="w" strong="H3485" x-morph="N-proper-ms" x-position="8" x-lemma="יִשָּׂשכָֽר׃" x-translit="yiś·śā·š·ḵār">of Issachar,</char> <char style="w" strong="H7126" x-morph="V-Hifil-Perf-3ms" x-position="3" x-lemma="הִקְרִ֖יב" x-translit="hiq·rîḇ">drew near.</char> <verse style="v" number="19"/><char style="w" strong="H7133" x-morph="N-msc | 3ms" x-position="3" x-lemma="קָרְבָּנ֜וֹ" x-translit="qā·rə·bā·nōw">The offering</char> <char style="w" strong="H7126" x-morph="V-Hifil-Perf-3ms" x-position="1" x-lemma="הִקְרִ֨ב" x-translit="hiq·riḇ">he presented</char> <char style="w" strong="H853" x-empty="true" x-morph="DirObjM" x-position="2" x-lemma="אֶת־"/><char style="w" strong="H259" x-morph="Number-fs" x-position="6" x-lemma="אַחַ֗ת" x-translit="’a·ḥaṯ">was one</char> <char style="w" strong="H3701" x-morph="N-ms" x-position="5" x-lemma="כֶּ֣סֶף" x-translit="ke·sep̄">silver</char> <char style="w" strong="H7086" x-morph="N-fsc" x-position="4" x-lemma="קַֽעֲרַת־" x-translit="qa·‘ă·raṯ-">platter</char> <char style="w" strong="H4948" x-morph="N-msc | 3fs" x-position="9" x-lemma="מִשְׁקָלָהּ֒" x-translit="miš·qā·lāh">weighing</char> <char style="w" strong="H7970" x-morph="Number-cp" x-position=