  <para style="p"> <verse style="v" number="78"/><char style="w" strong="H8147" x-morph="Number-md" x-position="2" x-lemma="שְׁנֵ֣ים" x-translit="šə·nêm">On the twelfth</char> <char style="w" strong="H6240" x-empty="true" x-morph="Number-ms" x-position="3" x-lemma="עָשָׂ֣ר"/><char style="w" strong="H3117" x-empty="true" x-morph="N-ms" x-position="4" x-lemma="י֔וֹם"/><char style="w" strong="H3117" x-morph="Prep-b | N-msc" x-position="1" x-lemma="בְּיוֹם֙" x-translit="bə·yō·wm">day</char> <char style="w" strong="H299" x-morph="N-proper-ms" x-position="8" x-lemma="אֲחִירַ֖ע" x-translit="’ă·ḥî·ra‘">Ahira</char> <char style="w" strong="H1121" x-morph="Prep-l | N-mpc" x-position="6" x-lemma="לִבְנֵ֣י" x-translit="liḇ·nê">son</char> <char style="w" strong="H5881" x-morph="N-proper-ms" x-position="10" x-lemma="עֵינָֽן׃" x-translit="‘ê·nān">of Enan,</char> <char style="w" strong="H5387" x-morph="N-ms" x-position="5" x-lemma="נָשִׂ֖יא" x-translit="nā·śî">the leader</char> <char style="w" strong="H1121" x-morph="N-msc" x-position="9" x-lemma="בֶּן־" x-translit="ben-">of the Naphtalites, drew near.</char><char style="w" strong="H5321" x-empty="true" x-morph="N-proper-ms" x-position="7" x-lemma="נַפְתָּלִ֑י"/> <verse style="v" number="79"/><char style="w" strong="H7133" x-morph="N-msc | 3ms" x-position="1" x-lemma="קָרְבָּנ֞וֹ" x-translit="qā·rə·bā·nōw">His offering</char> <char style="w" strong="H259" x-morph="Number-fs" x-position="4" x-lemma="אַחַ֗ת" x-translit="’a·ḥaṯ">was one</char> <char style="w" strong="H3701" x-morph="N-ms" x-position="3" x-lemma="כֶּ֣סֶף" x-translit="ke·sep̄">silver</char> <char style="w" strong="H7086" x-morph="N-fsc" x-position="2" x-lemma="קַֽעֲרַת־" x-translit="qa·‘ă·raṯ-">platter</char> <char style="w" strong="H4948" x-morph="N-msc | 3fs" x-position="7" x-lemma="מִשְׁקָלָהּ֒" x-translit="miš·qā·lāh">weighing</char> <char style="w" strong="H7970" x-morph="Number-cp" x-position="5" x-lemma="שְׁלֹשִׁ֣ים" x-translit="šə·lō·šîm">a hundred and thirty shekels,</char> <char style="w" strong="H3967" x-empty="true" x-morph="Conj-w | Number-fs" x-position="6" x-lemma="וּמֵאָה֮"/><char style="w" strong="H259" x-morph="Number-msc" x-position="9" x-lemma="אֶחָד֙" x-translit="’e·ḥāḏ">and one</char> <char style="w" strong="H3701" x-morph="N-ms" x-position="10" x-lemma="כֶּ֔סֶף" x-translit="ke·sep̄">silver</char> <char style="w" strong="H4219" x-morph="N-msc" x-position="8" x-lemma="מִזְרָ֤ק" x-translit="miz·rāq">bowl</char> <char style="w" strong="H7657" x-morph="Number-cp" x-position="11" x-lemma="שִׁבְעִ֥ים" x-translit="šiḇ·‘îm">weighing seventy</char> <char style="w" strong="H8255" x-morph="N-ms" x-position="12" x-lemma="שֶׁ֖קֶל" x-translit="še·qel">shekels,</char> <char style="w" strong="H6944" x-morph="Art | N-ms" x-position="14" x-lemma="הַקֹּ֑דֶשׁ" x-translit="haq·qō·ḏeš">both according to the sanctuary</char> <char style="w" strong="H8255" x-morph="Prep-b | N-msc" x-position="13" x-lemma="בְּשֶׁ֣קֶל" x-translit="bə·še·qel">shekel</char> <char style="w" strong="H8147" x-morph="Number-mdc | 3mp" x-position="15" x-lemma="שְׁנֵיהֶ֣ם׀" x-translit="šə·nê·hem">and</char> <char style="w" strong="H4392" x-morph="Adj-mp" x-position="16" x-lemma="מְלֵאִ֗ים" x-translit="mə·lê·’îm">filled with</char> <char style="w" strong="H5560" x-morph="N-fs" x-position="17" x-lemma="סֹ֛לֶת" x-translit="sō·leṯ">fine flour</char> <char style="w" strong="H1101" x-morph="V-Qal-QalPassPrtcpl-fs" x-position="18" x-lemma="בְּלוּלָ֥ה" x-translit="bə·lū·lāh">mixed</char> <char style="w" strong="H8081" x-morph="Prep-b, Art | N-ms" x-position="19" x-lemma="בַשֶּׁ֖מֶן" x-translit="ḇaš·še·men">with oil</char> <char style="w" strong="H4503" x-morph="Prep-l | N-fs" x-position="20" x-lemma="לְמִנְחָֽה׃" x-translit="lə·min·ḥāh">for a grain offering;</char> <verse style="v" number="80"/><char style="w" strong="H259" x-morph="Number-fs" x-position="2" x-lemma="אַחַ֛ת" x-translit="’a·ḥaṯ">one</char> <char style="w" strong="H2091" x-morph="N-ms" x-position="4"