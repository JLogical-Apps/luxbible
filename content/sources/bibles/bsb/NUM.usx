  <para style="p"> <verse style="v" number="24"/><char style="w" strong="H7992" x-morph="Art | Number-oms" x-position="2" x-lemma="הַשְּׁלִישִׁ֔י" x-translit="haš·šə·lî·šî">On the third</char> <char style="w" strong="H3117" x-morph="Prep-b, Art | N-ms" x-position="1" x-lemma="בַּיּוֹם֙" x-translit="bay·yō·wm">day</char> <char style="w" strong="H446" x-morph="N-proper-ms" x-position="6" x-lemma="אֱלִיאָ֖ב" x-translit="’ĕ·lî·’āḇ">Eliab</char> <char style="w" strong="H1121" x-morph="Prep-l | N-mpc" x-position="4" x-lemma="לִבְנֵ֣י" x-translit="liḇ·nê">son</char> <char style="w" strong="H2497" x-morph="N-proper-ms" x-position="8" x-lemma="חֵלֹֽן׃" x-translit="ḥê·lōn">of Helon,</char> <char style="w" strong="H5387" x-morph="N-ms" x-position="3" x-lemma="נָשִׂ֖יא" x-translit="nā·śî">the leader</char> <char style="w" strong="H1121" x-morph="N-msc" x-position="7" x-lemma="בֶּן־" x-translit="ben-">of the Zebulunites, drew near.</char><char style="w" strong="H2074" x-empty="true" x-morph="N-proper-ms" x-position="5" x-lemma="זְבוּלֻ֑ן"/> <verse style="v" number="25"/><char style="w" strong="H7133" x-morph="N-msc | 3ms" x-position="1" x-lemma="קָרְבָּנ֞וֹ" x-translit="qā·rə·bā·nōw">His offering</char> <char style="w" strong="H259" x-morph="Number-fs" x-position="4" x-lemma="אַחַ֗ת" x-translit="’a·ḥaṯ">was one</char> <char style="w" strong="H3701" x-morph="N-ms" x-position="3" x-lemma="כֶּ֣סֶף" x-translit="ke·sep̄">silver</char> <char style="w" strong="H7086" x-morph="N-fsc" x-position="2" x-lemma="קַֽעֲרַת־" x-translit="qa·‘ă·raṯ-">platter</char> <char style="w" strong="H4948" x-morph="N-msc | 3fs" x-position="7" x-lemma="מִשְׁקָלָהּ֒" x-translit="miš·qā·lāh">weighing</char> <char style="w" strong="H7970" x-morph="Number-cp" x-position="5" x-lemma="שְׁלֹשִׁ֣ים" x-translit="šə·lō·šîm">a hundred and thirty shekels,</char> <char style="w" strong="H3967" x-empty="true" x-morph="Conj-w | Number-fs" x-position="6" x-lemma="וּמֵאָה֮"/><char style="w" strong="H259" x-morph="Number-ms