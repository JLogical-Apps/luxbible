  <para style="li1"> <verse style="v" number="36"/><char style="w" strong="H1121" x-morph="Prep-l | N-mpc" x-position="1" x-lemma="לִבְנֵ֣י" x-translit="liḇ·nê">From the sons</char> <char style="w" strong="H1144" x-morph="N-proper-ms" x-position="2" x-lemma="בִנְיָמִ֔ן" x-translit="ḇin·yā·min">of Benjamin,</char> <char style="w" strong="H8435" x-morph="N-fpc | 3mp" x-position="3" x-lemma="תּוֹלְדֹתָ֥ם" x-translit="tō·wl·ḏō·ṯām">according to the records</char> <char style="w" strong="H4940" x-morph="Prep-l | N-fpc | 3mp" x-position="4" x-lemma="לְמִשְׁפְּחֹתָ֖ם" x-translit="lə·miš·pə·ḥō·ṯām">of their clans</char> <char style="w" strong="H1" x-morph="N-mpc | 3mp" x-position="6" x-lemma="אֲבֹתָ֑ם" x-translit="’ă·ḇō·ṯām">and families,</char> <char style="w" strong="H1004" x-empty="true" x-morph="Prep-l | N-msc" x-position="5" x-lemma="לְבֵ֣ית"/><char style="w" strong="H4557" x-morph="Prep-b | N-msc" x-position="7" x-lemma="בְּמִסְפַּ֣ר" x-translit="bə·mis·par">counting</char> <char style="w" strong="H8034" x-morph="N-mp" x-position="8" x-lemma="שֵׁמֹ֗ת" x-translit="šê·mōṯ">the names</char> <char style="w" strong="H3605" x-morph="N-msc" x-position="13" x-lemma="כֹּ֖ל" x-translit="kōl">of all those</char> <char style="w" strong="H6242" x-morph="Number-cp" x-position="10" x-lemma="עֶשְׂרִ֤ים" x-translit="‘eś·rîm">twenty</char> <char style="w" strong="H1121" x-morph="Prep-m | N-msc" x-position="9" x-lemma="מִבֶּ֨ן" x-translit="mib·ben">years of age</char> <char style="w" strong="H8141" x-empty="true" x-morph="N-fs" x-position="11" x-lemma="שָׁנָה֙"/><char style="w" strong="H4605" x-morph="Conj-w | Adv | 3fs" x-position="12" x-lemma="וָמַ֔עְלָה" x-translit="wā·ma‘·lāh">or older</char> <char style="w" strong="H3318" x-morph="V-Qal-Prtcpl-msc" x-position="14" x-lemma="יֹצֵ֥א" x-translit="yō·ṣê">who could serve</char> <char style="w" strong="H6635" x-morph="N-cs" x-position="15" x-lemma="צָבָֽא׃" x-translit="ṣā·ḇā">in the army,</char> <verse style="v" number="37"/><char style=