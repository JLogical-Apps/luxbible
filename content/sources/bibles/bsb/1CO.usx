  <para style="p"> <verse style="v" number="32"/><char style="w" strong="G1161" x-empty="true" x-morph="Conj" x-position="2" x-lemma="δὲ"/><char style="w" strong="G2309" x-morph="V-PIA-1S" x-position="1" x-lemma="Θέλω" x-translit="Thelō">I want</char> <char style="w" strong="G4771" x-morph="PPro-A2P" x-position="3" x-lemma="ὑμᾶς" x-translit="hymas">you</char> <char style="w" strong="G1510" x-morph="V-PNA" x-position="5" x-lemma="εἶναι" x-translit="einai">to be</char> <char style="w" strong="G275" x-morph="Adj-AMP" x-position="4" x-lemma="ἀμερίμνους" x-translit="amerimnous">free from concern.</char> <char style="w" strong="G3588" x-morph="Art-NMS" x-position="6" x-lemma="ὁ" x-translit="ho">The</char> <char style="w" strong="G22" x-morph="N-NMS" x-position="7" x-lemma="ἄγαμος" x-translit="agamos">unmarried man</char> <char style="w" strong="G3309" x-morph="V-PIA-3S" x-position="8" x-lemma="μεριμνᾷ" x-translit="merimna">is concerned about</char> <char style="w" strong="G3588" x-morph="Art-ANP" x-position="9" x-lemma="τὰ" x-translit="ta">the work</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="10" x-lemma="τοῦ" x-translit="tou">of the</char> <char style="w" strong="G2962" x-morph="N-GMS" x-position="11" x-lemma="Κυρίου" x-translit="Kyriou">Lord,</char> <char style="w" strong="G4459" x-morph="Adv" x-position="12" x-lemma="πῶς" x-translit="pōs">how</char> <char style="w" strong="G700" x-morph="V-ASA-3S" x-position="13" x-lemma="ἀρέσῃ" x-translit="aresē">he can please</char> <char style="w" strong="G3588" x-morph="Art-DMS" x-position="14" x-lemma="τῷ" x-translit="tō">the</char> <char style="w" strong="G2962" x-morph="N-DMS" x-position="15" x-lemma="Κυρίῳ" x-translit="Kyriō">Lord.</char> <verse style="v" number="33"/><char style="w" strong="G1161" x-morph="Conj" x-position="2" x-lemma="δὲ" x-translit="de">But</char> <char style="w" strong="G3588" x-morph="Art-NMS" x-position="1" x-lemma="ὁ" x-translit="ho">the</char> <char style="w" strong="G1060" x-morp