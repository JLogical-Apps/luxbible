  <para style="b"/>
  <para style="li1"> <verse style="v" number="32"/><char style="w" strong="H1121" x-morph="Conj-w | N-mpc" x-position="1" x-lemma="וּבְנֵ֤י" x-translit="ū·ḇə·nê">The sons</char> <char style="w" strong="H3047" x-morph="N-proper-ms" x-position="2" x-lemma="יָדָע֙" x-translit="yā·ḏā‘">of Jada</char> <char style="w" strong="H251" x-morph="N-msc" x-position="3" x-lemma="אֲחִ֣י" x-translit="’ă·ḥî">the brother</char> <char style="w" strong="H8060" x-morph="N-proper-ms" x-position="4" x-lemma="שַׁמַּ֔י" x-translit="šam·may">of Shammai:</char></para>
  <para style="li2"><char style="w" strong="H3500" x-morph="N-proper-ms" x-position="5" x-lemma="יֶ֖תֶר" x-translit="ye·ṯer">Jether</char> <char style="w" strong="H3129" x-morph="Conj-w | N-proper-ms" x-position="6" x-lemma="וְיוֹנָתָ֑ן" x-translit="wə·yō·w·nā·ṯān">and Jonathan.</char> <char style="w" strong="H3500" x-morph="N-proper-ms" x-position="8" x-lemma="יֶ֖תֶר" x-translit="ye·ṯer">Jether</char> <char style="w" strong="H4191" x-morph="Conj-w | V-Qal-ConsecImperf-3ms" x-position="7" x-lemma="וַיָּ֥מָת" x-translit="way·yā·māṯ">died</char> <char style="w" strong="H3808" x-morph="Adv-NegPrt" x-position="9" x-lemma="לֹ֥א" x-translit="lō">without</char> <char style="w" strong="H1121" x-morph="N-mp" x-position="10" x-lemma="בָנִֽים׃ס" x-translit="ḇā·nîm">children.</char></para>
  <para style="b"/>
  <para style="li1"> <verse style="v" number="33"/><char style="w" strong="H1121" x-morph="Conj-w | N-mpc" x-position="1" x-lemma="וּבְנֵ֥י" x-translit="ū·ḇə·nê">The sons</char> <char style="w" strong="H3129" x-morph="N-proper-ms" x-position="2" x-lemma="יוֹנָתָ֖ן" x-translit="yō·w·nā·ṯān">of Jonathan:</char></para>
