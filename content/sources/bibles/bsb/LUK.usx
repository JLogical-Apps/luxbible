  <para style="q1"> <verse style="v" number="27"/><char style="w" strong="G3588" x-morph="Art-GMS" x-position="1" x-lemma="τοῦ" x-translit="tou">the son</char> <char style="w" strong="G2490" x-morph="N-GMS" x-position="2" x-lemma="Ἰωανὰν" x-translit="Iōanan">of Joanan,</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="3" x-lemma="τοῦ" x-translit="tou">the son</char> <char style="w" strong="G4488" x-morph="N-GMS" x-position="4" x-lemma="Ῥησὰ" x-translit="Rhēsa">of Rhesa,</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="5" x-lemma="τοῦ" x-translit="tou">the son</char> <char style="w" strong="G2216" x-morph="N-GMS" x-position="6" x-lemma="Ζοροβάβελ" x-translit="Zorobabel">of Zerubbabel,</char></para>
