  <para style="q1"> <verse style="v" number="28"/><char style="w" strong="G3588" x-morph="Art-GMS" x-position="1" x-lemma="τοῦ" x-translit="tou">the son</char> <char style="w" strong="G3197" x-morph="N-GMS" x-position="2" x-lemma="Μελχὶ" x-translit="Melchi">of Melchi,</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="3" x-lemma="τοῦ" x-translit="tou">the son</char> <char style="w" strong="G78" x-morph="N-GMS" x-position="4" x-lemma="Ἀδδὶ" x-translit="Addi">of Addi,</char> <char style="w" strong="G3588" x-morph="Art-GMS" x-position="5" x-lemma="τοῦ" x-translit="tou">the son</char> <char style="w" strong="G2973" x-morph="N-GMS" x-position="6" x-lemma="Κωσὰμ" x-translit="Kōsam">of Cosam,</char></para>
