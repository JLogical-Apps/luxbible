  <para style="s1">No Greater Love</para>
  <para style="p"> <verse style="v" number="9"/><char style="wj"><char style="w" strong="G2531" x-morph="Adv" x-position="1" x-lemma="Καθὼς" x-translit="Kathōs">As</char> <char style="w" strong="G3588" x-morph="Art-NMS" x-position="4" x-lemma="ὁ" x-translit="ho">the</char> <char style="w" strong="G3962" x-morph="N-NMS" x-position="5" x-lemma="Πατήρ" x-translit="Patēr">Father</char> <char style="w" strong="G25" x-morph="V-AIA-3S" x-position="2" x-lemma="ἠγάπησέν" x-translit="ēgapēsen">has loved</char> <char style="w" strong="G1473" x-morph="PPro-A1S" x-position="3" x-lemma="με" x-translit="me">Me,</char> <char style="w" strong="G2504" x-morph="PPro-N1S" x-position="6" x-lemma="κἀγὼ" x-translit="kagō">so</char> <char style="w" strong="G25" x-morph="V-AIA-1S" x-position="8" x-lemma="ἠγάπησα" x-translit="ēgapēsa">have I loved</char> <char style="w" strong="G4771" x-morph="PPro-A2P" x-position="7" x-lemma="ὑμᾶς" x-translit="hymas">you.</char> <char style="w" strong="G3306" x-morph="V-AMA-2P" x-position="9" x-lemma="μείνατε" x-translit="meinate">Remain</char> <char style="w" strong="G1722" x-morph="Prep" x-position="10" x-lemma="ἐν" x-translit="en">in</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-DFS" x-position="13" x-lemma="τῇ"/><char style="w" strong="G1699" x-morph="PPro-DF1S" x-position="14" x-lemma="ἐμῇ" x-translit="emē">My</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-DFS" x-position="11" x-lemma="τῇ"/><char style="w" strong="G26" x-morph="N-DFS" x-position="12" x-lemma="ἀγάπῃ" x-translit="agapē">love.</char> <verse style="v" number="10"/><char style="w" strong="G1437" x-morph="Conj" x-position="1" x-lemma="ἐὰν" x-translit="ean">If</char> <char style="w" strong="G5083" x-morph="V-ASA-2P" x-position="5" x-lemma="τηρήσητε" x-translit="tērēsēte">you keep</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AFP" x-position="2" x-lemma="τὰς"/><char style="w" strong="G1473" x-morph="PPro-G1S" x-position="4" x-lemma="μο