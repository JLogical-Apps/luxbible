 x-lemma="τὰ"/><char style="w" strong="G1473" x-morph="PPro-G1S" x-position="8" x-lemma="μου" x-translit="mou">My</char> <char style="w" strong="G4487" x-morph="N-NNP" x-position="7" x-lemma="ῥήματά" x-translit="rhēmata">words</char> <char style="w" strong="G3306" x-morph="V-ASA-3S" x-position="11" x-lemma="μείνῃ" x-translit="meinē">remain</char> <char style="w" strong="G1722" x-morph="Prep" x-position="9" x-lemma="ἐν" x-translit="en">in</char> <char style="w" strong="G4771" x-morph="PPro-D2P" x-position="10" x-lemma="ὑμῖν" x-translit="hymin">you,</char> <char style="w" strong="G154" x-morph="V-AMM-2P" x-position="15" x-lemma="αἰτήσασθε" x-translit="aitēsasthe">ask</char> <char style="w" strong="G3739" x-morph="RelPro-ANS" x-position="12" x-lemma="ὃ" x-translit="ho">whatever</char> <char style="w" strong="G1437" x-empty="true" x-morph="Conj" x-position="13" x-lemma="ἐὰν"/><char style="w" strong="G2309" x-morph="V-PSA-2P" x-position="14" x-lemma="θέλητε" x-translit="thelēte">you wish,</char> <char style="w" strong="G2532" x-morph="Conj" x-position="16" x-lemma="καὶ" x-translit="kai">and</char> <char style="w" strong="G1096" x-morph="V-FIM-3S" x-position="17" x-lemma="γενήσεται" x-translit="genēsetai">it will be done</char> <char style="w" strong="G4771" x-morph="PPro-D2P" x-position="18" x-lemma="ὑμῖν" x-translit="hymin">for you.</char> <verse style="v" number="8"/><char style="w" strong="G1722" x-empty="true" x-morph="Prep" x-position="1" x-lemma="ἐν"/><char style="w" strong="G3778" x-morph="DPro-DNS" x-position="2" x-lemma="τούτῳ" x-translit="toutō">This is to</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NMS" x-position="4" x-lemma="ὁ"/><char style="w" strong="G1473" x-morph="PPro-G1S" x-position="6" x-lemma="μου" x-translit="mou">My</char> <char style="w" strong="G3962" x-morph="N-NMS" x-position="5" x-lemma="Πατήρ" x-translit="Patēr">Father’s</char> <char style="w" strong="G1392" x-morph="V-AIP-3S" x-position="3" x-lemma="ἐδοξάσθη" x-translit