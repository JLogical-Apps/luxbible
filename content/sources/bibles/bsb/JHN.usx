  <para style="p"> <verse style="v" number="14"/><char style="wj"><char style="w" strong="G4771" x-morph="PPro-N2P" x-position="1" x-lemma="Ὑμεῖς" x-translit="Hymeis">You</char> <char style="w" strong="G1510" x-morph="V-PIA-2P" x-position="4" x-lemma="ἐστε" x-translit="este">are</char> <char style="w" strong="G1473" x-morph="PPro-G1S" x-position="3" x-lemma="μού" x-translit="mou">My</char> <char style="w" strong="G5384" x-morph="Adj-NMP" x-position="2" x-lemma="φίλοι" x-translit="philoi">friends</char> <char style="w" strong="G1437" x-morph="Conj" x-position="5" x-lemma="ἐὰν" x-translit="ean">if</char> <char style="w" strong="G4160" x-morph="V-PSA-2P" x-position="6" x-lemma="ποιῆτε" x-translit="poiēte">you do</char> <char style="w" strong="G3739" x-morph="RelPro-ANP" x-position="7" x-lemma="ἃ" x-translit="ha">what</char> <char style="w" strong="G1473" x-morph="PPro-N1S" x-position="8" x-lemma="ἐγὼ" x-translit="egō">I</char> <char style="w" strong="G1781" x-morph="V-PIM/P-1S" x-position="9" x-lemma="ἐντέλλομαι" x-translit="entellomai">command</char> <char style="w" strong="G4771" x-morph="PPro-D2P" x-position="10" x-lemma="ὑμῖν" x-translit="hymin">you.</char> <verse style="v" number="15"/><char style="w" strong="G3765" x-morph="Adv" x-position="1" x-lemma="οὐκέτι" x-translit="ouketi">No longer</char> <char style="w" strong="G3004" x-morph="V-PIA-1S" x-position="2" x-lemma="λέγω" x-translit="legō">do I call</char> <char style="w" strong="G4771" x-morph="PPro-A2P" x-position="3" x-lemma="ὑμᾶς" x-translit="hymas">you</char> <char style="w" strong="G1401" x-morph="N-AMP" x-position="4" x-lemma="δούλους" x-translit="doulous">servants,</char> <char style="w" strong="G3754" x-morph="Conj" x-position="5" x-lemma="ὅτι" x-translit="hoti">for</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NMS" x-position="6" x-lemma="ὁ"/><char style="w" strong="G1401" x-morph="N-NMS" x-position="7" x-lemma="δοῦλος" x-translit="doulos">a servant</char> <char style="w" strong="