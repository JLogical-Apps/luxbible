  <para style="p"> <verse style="v" number="21"/><char style="w" strong="G2532" x-morph="Conj" x-position="1" x-lemma="Καὶ" x-translit="Kai">And</char> <char style="w" strong="G3588" x-morph="Art-NMP" x-position="2" x-lemma="οἱ" x-translit="hoi">the</char> <char style="w" strong="G1427" x-morph="Adj-NMP" x-position="3" x-lemma="δώδεκα" x-translit="dōdeka">twelve</char> <char style="w" strong="G4440" x-morph="N-NMP" x-position="4" x-lemma="πυλῶνες" x-translit="pylōnes">gates were</char> <char style="w" strong="G1427" x-morph="Adj-NMP" x-position="5" x-lemma="δώδεκα" x-translit="dōdeka">twelve</char> <char style="w" strong="G3135" x-morph="N-NMP" x-position="6" x-lemma="μαργαρῖται" x-translit="margaritai">pearls,</char> <char style="w" strong="G1538" x-morph="Adj-NMS" x-position="9" x-lemma="ἕκαστος" x-translit="hekastos">with each</char> <char style="w" strong="G1520" x-empty="true" x-morph="Adj-NMS" x-position="8" x-lemma="εἷς"/><char style="w" strong="G3588" x-empty="true" x-morph="Art-GMP" x-position="10" x-lemma="τῶν"/><char style="w" strong="G4440" x-morph="N-GMP" x-position="11" x-lemma="πυλώνων" x-translit="pylōnōn">gate</char> <char style="w" strong="G303" x-empty="true" x-morph="Adv" x-position="7" x-lemma="ἀνὰ"/><char style="w" strong="G1510" x-morph="V-IIA-3S" x-position="12" x-lemma="ἦν" x-translit="ēn">consisting</char> <char style="w" strong="G1537" x-morph="Prep" x-position="13" x-lemma="ἐξ" x-translit="ex">of</char> <char style="w" strong="G1520" x-morph="Adj-GMS" x-position="14" x-lemma="ἑνὸς" x-translit="henos">a single</char> <char style="w" strong="G3135" x-morph="N-GMS" x-position="15" x-lemma="μαργαρίτου" x-translit="margaritou">pearl.</char> <char style="w" strong="G2532" x-empty="true" x-morph="Conj" x-position="16" x-lemma="καὶ"/><char style="w" strong="G3588" x-morph="Art-NFS" x-position="17" x-lemma="ἡ" x-translit="hē">The</char> <char style="w" strong="G4113" x-morph="N-NFS" x-position="18" x-lemma="πλατεῖα" x-translit="plateia">main stree