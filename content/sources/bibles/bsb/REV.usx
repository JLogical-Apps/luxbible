  <para style="p"> <verse style="v" number="15"/><char style="w" strong="G2532" x-empty="true" x-morph="Conj" x-position="1" x-lemma="Καὶ"/><char style="w" strong="G3588" x-morph="Art-NMS" x-position="2" x-lemma="ὁ" x-translit="ho">The angel who</char> <char style="w" strong="G2980" x-morph="V-PPA-NMS" x-position="3" x-lemma="λαλῶν" x-translit="lalōn">spoke</char> <char style="w" strong="G3326" x-morph="Prep" x-position="4" x-lemma="μετ’" x-translit="met’">with</char> <char style="w" strong="G1473" x-morph="PPro-G1S" x-position="5" x-lemma="ἐμοῦ" x-translit="emou">me</char> <char style="w" strong="G2192" x-morph="V-IIA-3S" x-position="6" x-lemma="εἶχεν" x-translit="eichen">had</char> <char style="w" strong="G5552" x-morph="Adj-ANS" x-position="9" x-lemma="χρυσοῦν" x-translit="chrysoun">a golden</char> <char style="w" strong="G3358" x-morph="N-ANS" x-position="7" x-lemma="μέτρον" x-translit="metron">measuring</char> <char style="w" strong="G2563" x-morph="N-AMS" x-position="8" x-lemma="κάλαμον" x-translit="kalamon">rod</char> <char style="w" strong="G2443" x-morph="Conj" x-position="10" x-lemma="ἵνα" x-translit="hina">to</char> <char style="w" strong="G3354" x-morph="V-ASA-3S" x-position="11" x-lemma="μετρήσῃ" x-translit="metrēsē">measure</char> <char style="w" strong="G3588" x-morph="Art-AFS" x-position="12" x-lemma="τὴν" x-translit="tēn">the</char> <char style="w" strong="G4172" x-morph="N-AFS" x-position="13" x-lemma="πόλιν" x-translit="polin">city</char> <char style="w" strong="G2532" x-morph="Conj" x-position="14" x-lemma="καὶ" x-translit="kai">and</char> <char style="w" strong="G846" x-morph="PPro-GF3S" x-position="17" x-lemma="αὐτῆς" x-translit="autēs">its</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-AMP" x-position="15" x-lemma="τοὺς"/><char style="w" strong="G4440" x-morph="N-AMP" x-position="16" x-lemma="πυλῶνας" x-translit="pylōnas">gates</char> <char style="w" strong="G2532" x-morph="Conj" x-position="18" x-lemma="καὶ" x-translit="kai">and</char> <char style="w" strong="G846" x-empty="true" x-morph="PPro-GF3S" x-position="21" x-lemma="αὐτῆς"/><char style="w" strong="G3588" x-empty="true" x-morph="Art-ANS" x-position="19" x-lemma="τὸ"/><char style="w" strong="G5038" x-morph="N-ANS" x-position="20" x-lemma="τεῖχος" x-translit="teichos">walls.</char> <verse style="v" number="16"/><char style="w" strong="G2532" x-empty="true" x-morph="Conj" x-position="1" x-lemma="καὶ"/><char style="w" strong="G3588" x-morph="Art-NFS" x-position="2" x-lemma="ἡ" x-translit="hē">The</char> <char style="w" strong="G4172" x-morph="N-NFS" x-position="3" x-lemma="πόλις" x-translit="polis">city</char> <char style="w" strong="G2749" x-morph="V-PIM/P-3S" x-position="5" x-lemma="κεῖται" x-translit="keitai">lies</char> <char style="w" strong="G5068" x-morph="Adj-NFS" x-position="4" x-lemma="τετράγωνος" x-translit="tetragōnos">foursquare,</char> <char style="w" strong="G2532" x-morph="Conj" x-position="6" x-lemma="καὶ" x-translit="kai">with</char> <char style="w" strong="G2532" x-empty="true" x-morph="Conj" x-position="11" x-lemma="καὶ"/><char style="w" strong="G3588" x-morph="Art-NNS" x-position="12" x-lemma="τὸ" x-translit="to">its</char> <char style="w" strong="G4114" x-morph="N-NNS" x-position="13" x-lemma="πλάτος" x-translit="platos">width</char> <char style="w" strong="G3745" x-morph="RelPro-NNS" x-position="10" x-lemma="ὅσον" x-translit="hoson">the same as</char> <char style="w" strong="G846" x-morph="PPro-GF3S" x-position="9" x-lemma="αὐτῆς" x-translit="autēs">its</char> <char style="w" strong="G3588" x-empty="true" x-morph="Art-NNS" x-position="7" x-lemma="τὸ"/><char style="w" strong="G3372" x-morph="N-NNS" x-position="8" x-lemma="μῆκος" x-translit="mēkos">length.</char> <char style="w" strong="G2532" x-morph="Conj" x-position="14" x-lemma="καὶ" x-translit="kai">And</char> <char style="w" strong="G3354" x-morph="V-AIA-3S" x-position="15" x-lemma="ἐμέτρησεν" x-translit="emetrēsen">he measured</char> <char style="w" stro