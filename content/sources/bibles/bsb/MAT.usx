  <para style="p"> <verse style="v" number="21"/><char style="wj"><char style="w" strong="G3756" x-morph="Adv" x-position="1" x-lemma="Οὐ" x-translit="Ou">Not</char> <char style="w" strong="G3956" x-morph="Adj-NMS" x-position="2" x-lemma="πᾶς" x-translit="pas">everyone</char> <char style="w" strong="G3588" x-morph="Art-NMS" x-position="3" x-lemma="ὁ" x-translit="ho">who</char> <char style="w" strong="G3004" x-morph="V-PPA-NMS" x-position="4" x-lemma="λέγων" x-translit="legōn">says</char> <char style="w" strong="G1473" x-morph="PPro-D1S" x-position="5" x-lemma="μοι" x-translit="moi">to Me,</char> <char style="w" strong="G2962" x-morph="N-VMS" x-position="6" x-lemma="Κύριε" x-translit="Kyrie">‘Lord,</char> <char style="w" strong="G2962" x-morph="N-VMS" x-position="7" x-lemma="Κύριε" x-translit="Kyrie">Lord,’</char> <char style="w" strong="G1525" x-morph="V-FIM-3S" x-position="8" x-lemma="εἰσελεύσεται" x-translit="eiseleusetai">will enter</char> <char style="w" strong="G1519" x-empty="true" x-morph="Prep" x-position="9" x-lemma="εἰς"/><char style="w" strong="G3588" x-morph="Art-AFS" x-position="10" x-lemma="τὴν" x-translit="tēn">the</char> <char style="w" strong="G932" x-morph="N-AFS" x-position="11" x-lemma="βασιλείαν" x-translit="basileian">kingdom</char> <char style="w" strong="G3588" x-morph="Art-GMP" x-position="12" x-lemma="τῶν" x-translit="tōn">of</char> <char style="w" strong="G3772" x-morph="N-GMP" x-position="13" x-lemma="οὐρανῶν" x-translit="ouranōn">heaven,</char> <char style="w" strong="G235" x-morph="Conj" x-position="14" x-lemma="ἀλλ’" x-translit="all’">but only</char> <char style="w" strong="G3588" x-morph="Art-NMS" x-position="15" x-lemma="ὁ" x-translit="ho">he who</char> <char style="w" strong="G4160" x-morph="V-PPA-NMS" x-position="16" x-lemma="ποιῶν" x-translit="poiōn">does</char> <char style="w" strong="G3588" x-morph="Art-ANS" x-position="17" x-lemma="τὸ" x-translit="to">the</char> <char style="w" strong="G2307" x-morph="N-ANS" x-position="18" x-l