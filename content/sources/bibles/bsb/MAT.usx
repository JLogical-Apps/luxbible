550" x-morph="Adj-NNS" x-position="10" x-lemma="σαπρὸν" x-translit="sapron">and a bad</char> <char style="w" strong="G1186" x-morph="N-NNS" x-position="9" x-lemma="δένδρον" x-translit="dendron">tree</char> <char style="w" strong="G3761" x-morph="Conj" x-position="8" x-lemma="οὐδὲ" x-translit="oude">cannot</char> <char style="w" strong="G4160" x-morph="V-PNA" x-position="13" x-lemma="ποιεῖν" x-translit="poiein">bear</char> <char style="w" strong="G2570" x-morph="Adj-AMP" x-position="12" x-lemma="καλοὺς" x-translit="kalous">good</char> <char style="w" strong="G2590" x-morph="N-AMP" x-position="11" x-lemma="καρποὺς" x-translit="karpous">fruit.</char> <verse style="v" number="19"/><char style="w" strong="G3956" x-morph="Adj-NNS" x-position="1" x-lemma="πᾶν" x-translit="pan">Every</char> <char style="w" strong="G1186" x-morph="N-NNS" x-position="2" x-lemma="δένδρον" x-translit="dendron">tree</char> <char style="w" strong="G3361" x-empty="true" x-morph="Adv" x-position="3" x-lemma="μὴ"/><char style="w" strong="G4160" x-morph="V-PPA-NNS" x-position="4" x-lemma="ποιοῦν" x-translit="poioun">that does not bear</char> <char style="w" strong="G2570" x-morph="Adj-AMS" x-position="6" x-lemma="καλὸν" x-translit="kalon">good</char> <char style="w" strong="G2590" x-morph="N-AMS" x-position="5" x-lemma="καρπὸν" x-translit="karpon">fruit</char> <char style="w" strong="G1581" x-morph="V-PIM/P-3S" x-position="7" x-lemma="ἐκκόπτεται" x-translit="ekkoptetai">is cut down</char> <char style="w" strong="G2532" x-morph="Conj" x-position="8" x-lemma="καὶ" x-translit="kai">and</char> <char style="w" strong="G906" x-morph="V-PIM/P-3S" x-position="11" x-lemma="βάλλεται" x-translit="balletai">thrown</char> <char style="w" strong="G1519" x-morph="Prep" x-position="9" x-lemma="εἰς" x-translit="eis">into</char> <char style="w" strong="G4442" x-morph="N-ANS" x-position="10" x-lemma="πῦρ" x-translit="pyr">the fire.</char> <verse style="v" number="20"/><char style="w" strong="G686" x-morph="Prtcl" x-pos