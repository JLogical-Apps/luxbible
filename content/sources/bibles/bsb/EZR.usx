  <para style="p"> <verse style="v" number="42"/><char style="w" strong="H1121" x-empty="true" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵ֣י"/><char style="w" strong="H7778" x-morph="Art | N-mp" x-position="2" x-lemma="הַשֹּֽׁעֲרִ֗ים" x-translit="haš·šō·‘ă·rîm">The gatekeepers:</char></para>
