  <para style="p"> <verse style="v" number="41"/><char style="w" strong="H7891" x-morph="Art | V-Piel-Prtcpl-mp" x-position="1" x-lemma="הַֽמְשֹׁרְרִ֑ים" x-translit="ham·šō·rə·rîm">The singers:</char></para>
