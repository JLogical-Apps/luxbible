  <para style="li1"> <verse style="v" number="35"/><char style="w" strong="H1121" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵ֣י" x-translit="bə·nê">and the descendants</char> <char style="w" strong="H5570" x-morph="N-proper-ms" x-position="2" x-lemma="סְנָאָ֔ה" x-translit="sə·nā·’āh">of Senaah,</char><char style="w" strong="H7969" x-empty="true" x-morph="Number-msc" x-position="3" x-lemma="שְׁלֹ֣שֶׁת"/><char style="w" strong="H505" x-empty="true" x-morph="Number-mp" x-position="4" x-lemma="אֲלָפִ֔ים"/><char style="w" strong="H8337" x-empty="true" x-morph="Conj-w | Number-fsc" x-position="5" x-lemma="וְשֵׁ֥שׁ"/><char style="w" strong="H3967" x-empty="true" x-morph="Number-fp" x-position="6" x-lemma="מֵא֖וֹת"/><char style="w" strong="H7970" x-empty="true" x-morph="Conj-w | Number-cp" x-position="7" x-lemma="וּשְׁלֹשִֽׁים׃ס"/> 3,630.</para>
  <para style="p"> <verse style="v" number="36"/><char style="w" strong="H3548" x-morph="Art | N-mp" x-position="1" x-lemma="הַֽכֹּהֲנִ֑ים" x-translit="hak·kō·hă·nîm">The priests:</char></para>
  <para style="b"/>
