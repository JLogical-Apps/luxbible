  <para style="li1"> <verse style="v" number="32"/><char style="w" strong="H1121" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵ֣י" x-translit="bə·nê">the descendants</char> <char style="w" strong="H2766" x-morph="N-proper-ms" x-position="2" x-lemma="חָרִ֔ם" x-translit="ḥā·rim">of Harim,</char><char style="w" strong="H7969" x-empty="true" x-morph="Number-fsc" x-position="3" x-lemma="שְׁלֹ֥שׁ"/><char style="w" strong="H3967" x-empty="true" x-morph="Number-fp" x-position="4" x-lemma="מֵא֖וֹת"/><char style="w" strong="H6242" x-empty="true" x-morph="Conj-w | Number-cp" x-position="5" x-lemma="וְעֶשְׂרִֽים׃ס"/> 320;</para>
  <para style="li1"> <verse style="v" number="33"/><char style="w" strong="H1121" x-morph="N-mpc" x-position="1" x-lemma="בְּנֵי־" x-translit="bə·nê-">the men</char> <char style="w" strong="H3850" x-morph="N-proper-fs" x-position="2" x-lemma="לֹד֙" x-translit="lōḏ">of Lod,</char> <char style="w" strong="H2307" x-morph="N-proper-fs" x-position="3" x-lemma="חָדִ֣יד" x-translit="ḥā·ḏîḏ">Hadid,</char> <char style="w" strong="H207" x-morph="Conj-w | N-proper-fs" x-position="4" x-lemma="וְאוֹנ֔וֹ" x-translit="wə·’ō·w·nōw">and Ono,</char><char style="w" strong="H7651" x-empty="true" x-morph="Number-fsc" x-position="5" x-lemma="שְׁבַ֥ע"/><char style="w" strong="H3967" x-empty="true" x-morph="Number-fp" x-position="6" x-lemma="מֵא֖וֹת"/><char style="w" strong="H6242" x-empty="true" x-morph="Number-cp" x-position="7" x-lemma="עֶשְׂרִ֥ים"/><char style="w" strong="H2568" x-empty="true" x-morph="Conj-w | Number-ms" x-position="8" x-lemma="וַחֲמִשָּֽׁה׃ס"/> 725;</para>
