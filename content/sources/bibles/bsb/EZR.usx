  <para style="li2">139 <char style="w" strong="H3967" x-empty="true" x-morph="Number-fs" x-position="16" x-lemma="מֵאָ֖ה"/><char style="w" strong="H7970" x-empty="true" x-morph="Number-cp" x-position="17" x-lemma="שְׁלֹשִׁ֥ים"/><char style="w" strong="H8672" x-empty="true" x-morph="Conj-w | Number-ms" x-position="18" x-lemma="וְתִשְׁעָֽה׃פ"/><char style="w" strong="H3605" x-morph="Art | N-ms" x-position="15" x-lemma="הַכֹּ֕ל" x-translit="hak·kōl">in all.</char></para>
  <para style="p"> <verse style="v" number="43"/><char style="w" strong="H5411" x-morph="Art | N-mp" x-position="1" x-lemma="הַנְּתִינִ֑ים" x-translit="han·nə·ṯî·nîm">The temple servants:</char><note style="f" caller="+"><char style="fr">2:43 </char><char style="ft">Hebrew </char><char style="fqa">The Nethinim</char><char style="ft">; also in verses 58 and 70</char></note></para>
  <para style="b"/>
  <para style="li1"><char style="w" strong="H1121" x-morph="N-mpc" x-position="2" x-lemma="בְּנֵי־" x-translit="bə·nê-">the descendants</char> <char style="w" strong="H6727" x-morph="N-proper-ms" x-position="3" x-lemma="צִיחָ֥א" x-translit="ṣî·ḥā">of Ziha,</char></para>
